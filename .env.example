# TMDB API Key (v3 auth key or v4 read access token)
# Get it at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Kamal Production Deployment (cinelog.merendmrc.com)
# VPS_HOST=cinelog.merendmrc.com
KAMAL_REGISTRY_PASSWORD=
CINEMA_DATABASE_PASSWORD=your_secure_database_password_here
