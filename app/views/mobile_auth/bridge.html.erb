<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <title>CineLog</title>
    <style>
      body { margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #0A0A0C; color: #F1F3F7; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; padding: 24px; }
      .card { width: 100%; max-width: 360px; background: #15161C; border: 1px solid #262833; border-radius: 16px; padding: 28px 24px; text-align: center; }
      .title { font-size: 18px; font-weight: 700; margin: 0 0 8px; }
      .hint { font-size: 13px; color: #8B90A0; margin: 0 0 20px; }
      .btn { display: inline-block; width: 100%; box-sizing: border-box; padding: 12px 16px; border-radius: 12px; background: #6D28D9; color: #FFFFFF; font-weight: 600; font-size: 14px; text-decoration: none; }
    </style>
  </head>
  <body>
    <div class="card">
      <h1 class="title"><%= @deep_link_error.present? ? "Giriş Tamamlanamadı" : "Giriş Başarılı" %></h1>
      <p class="hint">Uygulamaya dönülüyor…</p>
      <a href="<%= @deep_link_url %>" class="btn">Uygulamaya Dön</a>
    </div>
    <%= javascript_tag nonce: true do %>
      window.location.replace(<%= raw @deep_link_url.to_json %>);
    <% end %>
  </body>
</html>
