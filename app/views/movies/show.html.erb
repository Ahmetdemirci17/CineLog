<%
  title = @movie["title"]
  original_title = @movie["original_title"]
  backdrop_path = @movie["backdrop_path"]
  poster_path = @movie["poster_path"]
  release_date = @movie["release_date"]
  year = release_date.present? ? release_date.split("-").first : nil
  runtime = @movie["runtime"]
  hours = runtime ? runtime / 60 : 0
  mins = runtime ? runtime % 60 : 0
  rating = @movie["vote_average"] ? @movie["vote_average"].round(1) : nil
  genres = @movie["genres"] || []
  cast = @movie.dig("credits", "cast") || []
  recommendations = @movie.dig("recommendations", "results") || []
%>

<div class="space-y-8 sm:space-y-12">
  <!-- Backdrop Banner & Movie Header -->
  <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden bg-[#15161c] border border-[#262833] shadow-lg">
    <!-- Backdrop Background -->
    <div class="relative h-[220px] sm:h-[360px] lg:h-[440px] w-full">
      <% if backdrop_path.present? %>
        <img src="<%= TmdbService.backdrop_url(backdrop_path) %>" alt="<%= title %>" class="w-full h-full object-cover object-center opacity-30">
      <% else %>
        <div class="w-full h-full bg-[#1c1d25] opacity-30"></div>
      <% end %>
      <div class="absolute inset-0 bg-gradient-to-t from-[#15161c] via-[#15161c]/80 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#15161c] via-[#15161c]/90 to-transparent"></div>
    </div>

    <!-- Movie Details Overlay -->
    <div class="relative -mt-24 sm:-mt-44 lg:-mt-56 px-4 sm:px-10 pb-6 sm:pb-10 flex flex-col md:flex-row gap-5 sm:gap-8 items-start">
      <!-- Poster with Matte Border -->
      <div class="w-32 sm:w-56 lg:w-64 shrink-0 rounded-xl sm:rounded-2xl overflow-hidden border border-[#262833] shadow-xl bg-[#1c1d25] self-center md:self-start">
        <% if poster_path.present? %>
          <img src="<%= TmdbService.poster_url(poster_path) %>" alt="<%= title %>" class="w-full h-auto object-cover">
        <% else %>
          <div class="aspect-[2/3] flex items-center justify-center text-[#686d80] text-xs">Afiş Yok</div>
        <% end %>
      </div>

      <!-- Main Metadata -->
      <div class="flex-1 space-y-3 sm:space-y-4 pt-2 sm:pt-14 w-full">
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
          <span class="px-2 sm:px-2.5 py-0.5 sm:py-1 text-[10px] sm:text-xs font-semibold uppercase rounded-md bg-[#221e30] text-[#a78bfa] border border-[#a78bfa]/25">
            Film
          </span>
          <% if year.present? %>
            <span class="px-2 sm:px-2.5 py-0.5 sm:py-1 text-[10px] sm:text-xs font-medium rounded-md bg-[#1c1d25] text-[#8b90a0] border border-[#262833]">
              <%= year %>
            </span>
          <% end %>
          <% if runtime.present? && runtime > 0 %>
            <span class="px-2 sm:px-2.5 py-0.5 sm:py-1 text-[10px] sm:text-xs font-medium rounded-md bg-[#1c1d25] text-[#8b90a0] border border-[#262833]">
              <%= hours > 0 ? "#{hours} sa " : "" %><%= mins %> dk
            </span>
          <% end %>
          <% if rating.present? %>
            <span class="px-2 sm:px-2.5 py-0.5 sm:py-1 text-[10px] sm:text-xs font-bold rounded-md bg-[#1c1d25] text-amber-400 border border-[#262833] flex items-center gap-1">
              <span>★</span>
              <span><%= rating %></span>
            </span>
          <% end %>
        </div>

        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-[#f1f3f7] tracking-tight leading-tight">
          <%= title %>
        </h1>

        <% if original_title.present? && original_title != title %>
          <p class="text-xs text-[#8b90a0] italic">Orijinal İsim: <%= original_title %></p>
        <% end %>

        <!-- Genres -->
        <% if genres.any? %>
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 pt-1">
            <span class="text-xs text-[#8b90a0] font-medium mr-1">Kategoriler:</span>
            <% genres.each do |genre| %>
              <%= link_to genre_path(genre["id"]), class: "px-2.5 sm:px-3 py-1 text-xs font-semibold rounded-lg bg-[#1c1d25] hover:bg-[#272236] text-[#a78bfa] border border-[#262833] hover:border-[#a78bfa]/40 transition duration-150 shadow-sm" do %>
                <%= genre["name"] %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <!-- Overview -->
        <div class="pt-2">
          <h3 class="text-xs font-bold uppercase tracking-wider text-[#a78bfa] mb-1">Özet</h3>
          <p class="text-xs sm:text-sm text-[#8b90a0] leading-relaxed max-w-3xl">
            <%= @movie["overview"].presence || "Bu film için henüz Türkçe özet eklenmemiş." %>
          </p>
        </div>

        <!-- Watchlist Action Controls -->
        <div class="pt-3 sm:pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 sm:gap-3">
          <div class="bg-[#1c1d25] p-2 sm:p-2.5 rounded-xl border border-[#262833]">
            <%= render "watchlists/action_button", tmdb_id: @movie["id"], media_type: "movie", title: title, poster_path: poster_path, watchlist_item: @watchlist_item, compact: false %>
          </div>

          <%= link_to new_community_post_path(tmdb_id: @movie["id"], media_type: "movie", movie_title: title), class: "px-3.5 py-2.5 text-xs font-semibold rounded-xl bg-[#1c1d25] hover:bg-[#252333] text-[#f1f3f7] hover:text-[#a78bfa] border border-[#262833] hover:border-[#a78bfa]/30 transition duration-150 flex items-center justify-center gap-2" do %>
            <svg class="w-4 h-4 text-[#a78bfa]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            <span>Toplulukta Bu Filmi Sor</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Cast -->
  <% if cast.any? %>
    <div class="space-y-3 sm:space-y-4">
      <h2 class="text-base sm:text-lg font-bold text-[#f1f3f7] flex items-center gap-2">
        <span class="w-2 h-4 rounded bg-[#7c3aed]"></span>
        Oyuncular
      </h2>
      <div class="flex gap-3 overflow-x-auto pb-3 -mx-3 px-3 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 scroll-smooth snap-x">
        <% cast.first(12).each do |actor| %>
          <%= link_to person_path(actor["id"]), class: "w-40 sm:w-auto shrink-0 snap-start bg-[#15161c] hover:bg-[#1f2029] p-2.5 rounded-xl border border-[#262833] hover:border-purple-500/40 flex items-center gap-2.5 transition duration-150 group cursor-pointer shadow-sm" do %>
            <% if actor["profile_path"].present? %>
              <img src="<%= TmdbService.poster_url(actor["profile_path"], size: "w185") %>" alt="<%= actor["name"] %>" class="w-10 h-10 rounded-full object-cover shrink-0 border border-[#262833] group-hover:border-purple-500/40 transition">
            <% else %>
              <div class="w-10 h-10 rounded-full bg-[#1c1d25] text-purple-400 flex items-center justify-center text-xs font-bold shrink-0 border border-[#262833]">
                <%= actor["name"][0] %>
              </div>
            <% end %>
            <div class="min-w-0 flex-1">
              <p class="text-xs font-bold text-white group-hover:text-purple-300 truncate transition"><%= actor["name"] %></p>
              <p class="text-[10px] text-zinc-400 truncate"><%= actor["character"] %></p>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Related Community Discussions -->
  <div class="space-y-4 pt-4 border-t border-[#1f202a]">
    <div class="flex items-center justify-between">
      <h2 class="text-lg font-bold text-[#f1f3f7] flex items-center gap-2">
        <span class="w-2 h-4 rounded bg-[#9d8ec2]"></span>
        Topluluk Yorumları & Soruları
      </h2>
      <%= link_to "Yeni Konu Aç", new_community_post_path(tmdb_id: @movie["id"], media_type: "movie", movie_title: title), class: "text-xs font-semibold text-[#a78bfa] hover:text-white transition" %>
    </div>

    <% if @community_posts.empty? %>
      <div class="p-6 rounded-2xl bg-[#15161c] border border-[#262833] text-center">
        <p class="text-xs text-[#8b90a0]">Bu film hakkında henüz bir soru veya öneri paylaşılmamış.</p>
        <%= link_to "İlk soruyu sen sor!", new_community_post_path(tmdb_id: @movie["id"], media_type: "movie", movie_title: title), class: "inline-block mt-3 px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-[#272236] text-[#a78bfa] border border-[#a78bfa]/25 hover:bg-[#6d28d9] hover:text-white transition" %>
      </div>
    <% else %>
      <div class="space-y-3">
        <% @community_posts.each do |post| %>
          <%= link_to community_post_path(post), class: "block p-4 rounded-xl bg-[#15161c] border border-[#262833] hover:border-[#a78bfa]/30 transition" do %>
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-bold text-[#f1f3f7]"><%= post.title %></h3>
              <span class="text-xs text-[#8b90a0]"><%= post.community_replies.count %> Yanıt</span>
            </div>
            <p class="text-xs text-[#8b90a0] mt-1 line-clamp-1"><%= post.content %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Recommendations -->
  <% if recommendations.any? %>
    <div class="space-y-4 pt-4 border-t border-[#1f202a]">
      <h2 class="text-lg font-bold text-[#f1f3f7] flex items-center gap-2">
        <span class="w-2 h-4 rounded bg-[#7c3aed]"></span>
        Benzer Öneriler
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        <% recommendations.first(5).each do |rec| %>
          <%= render "movies/card", item: rec, watchlist_map: {} %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
