<div class="space-y-8">
  <!-- Search Header & Bar -->
  <div class="max-w-2xl mx-auto text-center space-y-3">
    <h1 class="text-3xl font-black text-[#f1f3f7] tracking-tight">
      Film ve Dizi <span class="text-[#a78bfa]">Arama</span>
    </h1>
    <p class="text-xs sm:text-sm text-[#8b90a0]">CineLog arşivinde film ve dizi arayın.</p>

    <div class="relative mt-4" data-controller="autocomplete" data-autocomplete-url-value="<%= search_suggestions_path %>">
      <%= form_with url: search_path, method: :get do |f| %>
        <div class="relative flex items-center">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="h-4 w-4 text-[#a78bfa]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <%= f.text_field :query, value: @query, autofocus: true, autocomplete: "off", placeholder: "Örn: Interstellar, Breaking Bad, Nolan...", data: { autocomplete_target: "input", action: "input->autocomplete#search focus->autocomplete#search" }, class: "w-full pl-11 pr-20 sm:pr-24 py-3 bg-[#15161c] border border-[#262833] focus:border-[#7c3aed] rounded-2xl text-[#f1f3f7] placeholder-[#686d80] focus:outline-none focus:ring-1 focus:ring-[#7c3aed] text-base sm:text-sm transition shadow-sm" %>
          <button type="submit" class="absolute right-2 px-3.5 py-1.5 bg-[#6d28d9] hover:bg-[#5b21b6] text-white font-semibold text-xs rounded-xl transition cursor-pointer shadow-sm">
            Ara
          </button>
        </div>
      <% end %>

      <div data-autocomplete-target="results" class="hidden absolute left-0 right-0 top-full mt-2 bg-[#15161c] border border-[#262833] rounded-2xl shadow-2xl z-50 overflow-hidden text-left max-h-[60vh] overflow-y-auto">
      </div>
    </div>
  </div>

  <% if @query.present? %>
    <div class="space-y-4">
      <div class="flex items-center justify-between border-b border-[#1f202a] pb-3">
        <h2 class="text-xs sm:text-sm font-semibold text-[#8b90a0]">
          "<span class="text-[#f1f3f7] font-bold"><%= @query %></span>" için <%= @results.size %> sonuç bulundu
        </h2>
      </div>

      <% if @results.empty? %>
        <div class="text-center py-20 bg-[#15161c] rounded-2xl border border-[#262833]">
          <p class="text-sm font-bold text-[#f1f3f7]">Aradığınız kriterlere uygun sonuç bulunamadı.</p>
          <p class="text-xs text-[#8b90a0] mt-1">Farklı anahtar kelimeler ile tekrar deneyin.</p>
        </div>
      <% else %>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-6">
          <% @results.each do |item| %>
            <%= render "movies/card", item: item, watchlist_map: @user_watchlist_map %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
