<% if @query.present? && @results.any? %>
  <div class="py-2 divide-y divide-zinc-800/60">
    <div class="px-4 py-2 text-[11px] font-bold text-zinc-400 uppercase tracking-wider flex items-center justify-between bg-zinc-900/40">
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Önerilen Sonuçlar
      </span>
      <span class="text-[10px] text-purple-400 font-medium">CineLog</span>
    </div>

    <% @results.each do |item| %>
      <%
        item_id = item["id"]
        media_type = item["media_type"].presence || (item["title"].present? ? "movie" : (item["profile_path"].present? ? "person" : "tv"))
        
        if media_type == "person"
          title = item["name"]
          poster = item["profile_path"]
          url = person_path(item_id)
          known_for = (item["known_for"] || []).map { |k| k["title"] || k["name"] }.compact.first(2).join(", ")
          dept = item["known_for_department"] == "Directing" ? "Yönetmen" : "Oyuncu"
        elsif media_type == "tv"
          title = item["name"]
          poster = item["poster_path"]
          url = tv_show_path(item_id)
        else
          title = item["title"]
          poster = item["poster_path"]
          url = movie_path(item_id)
        end

        release_date = item["release_date"] || item["first_air_date"]
        year = release_date.present? ? release_date.split("-").first : nil
        rating = item["vote_average"] ? item["vote_average"].round(1) : nil
      %>
      <%= link_to url, data: { turbo_frame: "_top" }, class: "flex items-center gap-3.5 px-4 py-2.5 hover:bg-zinc-800/60 transition-all duration-150 group cursor-pointer" do %>
        <% if poster.present? %>
          <img src="<%= TmdbService.poster_url(poster, size: "w92") %>" alt="<%= title %>" class="w-12 h-16 rounded-lg object-cover bg-zinc-800 shrink-0 border border-zinc-700/60 shadow-md group-hover:border-purple-500/40 transition">
        <% else %>
          <div class="w-12 h-16 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-xs text-zinc-500 shrink-0">
            <%= media_type == 'person' ? '👤' : '🎬' %>
          </div>
        <% end %>

        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-white group-hover:text-purple-300 truncate transition-colors">
            <%= title %>
          </p>
          <div class="flex items-center gap-2 mt-1 text-xs text-zinc-400">
            <% if media_type == "person" %>
              <span class="px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-300 font-semibold text-[10px] uppercase tracking-wider border border-amber-500/25">
                <%= dept %>
              </span>
              <% if known_for.present? %>
                <span class="text-zinc-400 text-[11px] truncate">Örn: <%= known_for %></span>
              <% end %>
            <% else %>
              <span class="px-1.5 py-0.5 rounded bg-purple-500/15 text-purple-300 font-semibold text-[10px] uppercase tracking-wider border border-purple-500/25">
                <%= media_type == 'tv' ? 'Dizi' : 'Film' %>
              </span>
              <% if year.present? %>
                <span class="text-zinc-400 font-medium">• <%= year %></span>
              <% end %>
              <% if rating.present? && rating > 0 %>
                <span class="flex items-center gap-1 text-amber-400 font-bold ml-auto text-xs bg-amber-400/10 px-2 py-0.5 rounded-md border border-amber-400/20">
                  <svg class="w-3 h-3 fill-amber-400" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  <%= rating %>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="text-zinc-600 group-hover:text-purple-400 group-hover:translate-x-1 transition-all ml-1 shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      <% end %>
    <% end %>

    <div class="p-2.5 bg-zinc-900/40">
      <%= link_to search_path(query: @query), data: { turbo_frame: "_top" }, class: "flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-purple-600/15 hover:bg-purple-600 text-purple-300 hover:text-white text-xs font-semibold border border-purple-500/25 transition-all shadow-sm group" do %>
        <span>"<%= @query %>" için tüm sonuçları gör</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      <% end %>
    </div>
  </div>
<% elsif @query.present? && @results.empty? %>
  <div class="p-6 text-center">
    <p class="text-sm text-zinc-300">"<span class="text-white font-semibold"><%= @query %></span>" için sonuç bulunamadı.</p>
    <p class="text-xs text-zinc-500 mt-1">Farklı anahtar kelimelerle aramayı deneyebilirsiniz.</p>
  </div>
<% end %>
