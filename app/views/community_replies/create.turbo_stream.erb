<%= turbo_stream.append "replies_list" do %>
  <%= render "community_replies/reply", reply: @reply %>
<% end %>

<%= turbo_stream.update "replies_count" do %>
  <%= @community_post.community_replies.count %> Yanıt
<% end %>

<%= turbo_stream.replace "new_reply_form" do %>
  <%= render partial: "community_replies/form", locals: { community_post: @community_post, reply: CommunityReply.new } %>
<% end %>

<%= turbo_stream.remove "no_replies_banner" %>

<%= turbo_stream.prepend "flash-messages" do %>
  <div class="pointer-events-auto flex items-center justify-between p-4 rounded-xl bg-[#121217] border border-[rgba(168,85,247,0.3)] text-white shadow-[0_0_20px_rgba(168,85,247,0.2)]">
    <div class="flex items-center gap-3">
      <span class="w-6 h-6 rounded-full bg-[#9333ea]/30 text-[#c084fc] flex items-center justify-center font-bold text-xs">✓</span>
      <p class="text-xs sm:text-sm font-medium text-[#f8fafc]">Yanıtınız anında eklendi!</p>
    </div>
    <button onclick="this.parentElement.remove()" class="text-[#94a3b8] hover:text-white text-xs ml-3 p-1 cursor-pointer">✕</button>
  </div>
<% end %>
