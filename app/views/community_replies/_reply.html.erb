<div id="community_reply_<%= reply.id %>" class="p-3.5 rounded-xl bg-[#15161c] border border-[#262833] transition duration-150">
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-2.5">
      <div class="w-6 h-6 rounded-lg bg-[#272236] border border-[#a78bfa]/25 flex items-center justify-center text-xs font-bold text-[#a78bfa]">
        <%= reply.user.username[0].upcase %>
      </div>
      <div>
        <span class="text-xs font-bold text-[#f1f3f7]"><%= reply.user.username %></span>
        <span class="text-[11px] text-[#686d80] ml-1.5"><%= time_ago_in_words(reply.created_at) %> önce</span>
      </div>
    </div>

    <% if user_signed_in? && reply.user == current_user %>
      <%= button_to community_post_community_reply_path(reply.community_post, reply), method: :delete, class: "text-[#686d80] hover:text-red-400 text-xs transition p-1 cursor-pointer", title: "Yanıtı Sil" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      <% end %>
    <% end %>
  </div>

  <div class="mt-2 text-xs sm:text-sm text-[#cbd5e1] leading-relaxed pl-8">
    <%= simple_format(reply.content, class: "whitespace-pre-wrap") %>
  </div>
</div>
