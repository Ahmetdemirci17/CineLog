<div class="space-y-8">
  <!-- Header Title & User Summary -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 border-b border-zinc-800/80 pb-6">
    <div>
      <h1 class="text-3xl lg:text-4xl font-black text-white tracking-tight">
        İzleme <span class="text-purple-400">Listem</span>
      </h1>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">Kaydettiğiniz filmler, diziler ve izleme geçmişiniz.</p>
    </div>

    <!-- Segmented Pill Bar Navigation -->
    <div class="bg-zinc-900/80 p-1.5 rounded-2xl border border-zinc-800/80 inline-flex items-center gap-1.5 self-start md:self-auto shadow-inner overflow-x-auto max-w-full">
      <%= link_to watchlists_path(tab: "plan_to_watch"), class: "px-4 sm:px-5 py-2.5 rounded-xl font-medium text-xs sm:text-sm transition-all duration-200 flex items-center gap-2 shrink-0 #{@active_tab == 'plan_to_watch' ? 'bg-purple-600 text-white font-semibold shadow-lg shadow-purple-600/25' : 'text-zinc-400 hover:text-white hover:bg-zinc-800/50'}" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>İzleyeceklerim</span>
        <span class="px-2 py-0.5 text-[11px] rounded-full font-bold <%= @active_tab == 'plan_to_watch' ? 'bg-black/30 text-white' : 'bg-zinc-800 text-zinc-300' %>">
          <%= @plan_to_watch_items.count %>
        </span>
      <% end %>

      <%= link_to watchlists_path(tab: "watched"), class: "px-4 sm:px-5 py-2.5 rounded-xl font-medium text-xs sm:text-sm transition-all duration-200 flex items-center gap-2 shrink-0 #{@active_tab == 'watched' ? 'bg-purple-600 text-white font-semibold shadow-lg shadow-purple-600/25' : 'text-zinc-400 hover:text-white hover:bg-zinc-800/50'}" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>İzlediklerim</span>
        <span class="px-2 py-0.5 text-[11px] rounded-full font-bold <%= @active_tab == 'watched' ? 'bg-black/30 text-white' : 'bg-zinc-800 text-zinc-300' %>">
          <%= @watched_items.count %>
        </span>
      <% end %>

      <%= link_to watchlists_path(tab: "recommendations"), class: "px-4 sm:px-5 py-2.5 rounded-xl font-medium text-xs sm:text-sm transition-all duration-200 flex items-center gap-2 shrink-0 #{@active_tab == 'recommendations' ? 'bg-purple-600 text-white font-semibold shadow-lg shadow-purple-600/25' : 'text-zinc-400 hover:text-white hover:bg-zinc-800/50'}" do %>
        <svg class="w-4 h-4 text-purple-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Sana Özel Öneriler</span>
        <span class="px-2 py-0.5 text-[10px] font-bold rounded-full <%= @active_tab == 'recommendations' ? 'bg-black/30 text-white' : 'bg-purple-600/20 text-purple-300 border border-purple-500/30' %>">
          ✨ Yapay Zeka
        </span>
      <% end %>
    </div>
  </div>

  <% if @active_tab == "watched" %>
    <% if @watched_items.empty? %>
      <div class="text-center py-20 bg-[#121217] rounded-3xl border border-zinc-800/80 p-8 shadow-xl">
        <div class="w-16 h-16 rounded-2xl bg-purple-600/10 border border-purple-500/20 text-purple-400 flex items-center justify-center mx-auto mb-4 text-2xl">
          🎬
        </div>
        <h3 class="text-lg font-bold text-white">Henüz izlediğiniz film veya dizi yok</h3>
        <p class="text-xs sm:text-sm text-zinc-400 max-w-sm mx-auto mt-2 leading-relaxed">
          Katalogdan beğendiğiniz yapımları "İzledim" olarak işaretleyip puanlayarak izleme geçmişinizi oluşturabilirsiniz.
        </p>
        <div class="mt-6">
          <%= link_to "Kataloğu Keşfet", root_path, class: "px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold shadow-lg shadow-purple-600/25 transition duration-200 inline-block" %>
        </div>
      </div>
    <% else %>
      <% if @stats.present? %>
        <!-- Sinema Karnem / Watchlist Stats Panel -->
        <div class="bg-[#121217] rounded-2xl sm:rounded-3xl border border-zinc-800/80 p-4 sm:p-6 shadow-xl relative overflow-hidden">
          <!-- Background Ambient Glow -->
          <div class="absolute -top-24 -right-24 w-72 h-72 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>

          <!-- Header -->
          <div class="flex items-center justify-between gap-4 mb-5 pb-3 border-b border-zinc-800/60 relative z-10">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
              </div>
              <div>
                <h2 class="text-sm sm:text-base font-bold text-white flex items-center gap-2">
                  <span>Sinema Karnem</span>
                  <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-purple-500/15 text-purple-300 border border-purple-500/30">İstatistikler</span>
                </h2>
                <p class="text-[11px] text-zinc-400">İzlediğiniz yapımların süre, puan ve tür analizi</p>
              </div>
            </div>

            <span class="text-xs text-zinc-500 font-medium hidden sm:inline-block">
              <%= @stats[:total_watched] %> Yapım İncelendi
            </span>
          </div>

          <!-- 4 Stats Cards Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 relative z-10">
            <!-- 1. Card: Total Runtime -->
            <div class="bg-[#181920] rounded-xl sm:rounded-2xl p-4 border border-zinc-800 flex flex-col justify-between group hover:border-purple-500/40 transition">
              <div class="flex items-center justify-between text-zinc-400 text-xs mb-2">
                <span class="font-medium text-zinc-400">Toplam Süre</span>
                <span class="text-purple-400">⏱️</span>
              </div>
              <div>
                <div class="text-xl sm:text-2xl font-black text-white tracking-tight">
                  <%= @stats[:total_hours] %> <span class="text-sm font-semibold text-zinc-400">saat</span>
                </div>
                <p class="text-[11px] text-purple-300 font-medium mt-1">
                  <% if @stats[:days] > 0 %>
                    <%= @stats[:days] %> gün <%= @stats[:remaining_hours] %> saat maraton
                  <% else %>
                    <%= @stats[:total_minutes] %> dakika
                  <% end %>
                </p>
              </div>
            </div>

            <!-- 2. Card: Average Rating -->
            <div class="bg-[#181920] rounded-xl sm:rounded-2xl p-4 border border-zinc-800 flex flex-col justify-between group hover:border-amber-500/40 transition">
              <div class="flex items-center justify-between text-zinc-400 text-xs mb-2">
                <span class="font-medium text-zinc-400">Puan Ortalaması</span>
                <span class="text-amber-400">★</span>
              </div>
              <div>
                <div class="text-xl sm:text-2xl font-black text-white tracking-tight flex items-baseline gap-1.5">
                  <% if @stats[:avg_rating] %>
                    <span class="text-amber-400">★</span>
                    <span><%= @stats[:avg_rating] %></span>
                    <span class="text-xs font-normal text-zinc-500">/ 10</span>
                  <% else %>
                    <span class="text-sm font-semibold text-zinc-500">Puan Yok</span>
                  <% end %>
                </div>
                <p class="text-[11px] text-zinc-400 mt-1">
                  <%= @stats[:rated_count] %> yapım puanlandı
                </p>
              </div>
            </div>

            <!-- 3. Card: Watch Volume -->
            <div class="bg-[#181920] rounded-xl sm:rounded-2xl p-4 border border-zinc-800 flex flex-col justify-between group hover:border-blue-500/40 transition">
              <div class="flex items-center justify-between text-zinc-400 text-xs mb-2">
                <span class="font-medium text-zinc-400">İzleme Hacmi</span>
                <span class="text-blue-400">🎬</span>
              </div>
              <div>
                <div class="text-xl sm:text-2xl font-black text-white tracking-tight">
                  <%= @stats[:total_watched] %> <span class="text-sm font-semibold text-zinc-400">yapım</span>
                </div>
                <p class="text-[11px] text-zinc-400 mt-1 flex items-center gap-2">
                  <span><%= @stats[:movies_count] %> Film</span>
                  <% if @stats[:tv_count] > 0 %>
                    <span>•</span>
                    <span><%= @stats[:tv_count] %> Dizi</span>
                  <% end %>
                </p>
              </div>
            </div>

            <!-- 4. Card: Top Genres Distribution -->
            <div class="bg-[#181920] rounded-xl sm:rounded-2xl p-4 border border-zinc-800 flex flex-col justify-between group hover:border-emerald-500/40 transition">
              <div class="flex items-center justify-between text-zinc-400 text-xs mb-2">
                <span class="font-medium text-zinc-400">Favori Türler</span>
                <span class="text-emerald-400">📊</span>
              </div>
              <div class="space-y-1.5 pt-0.5">
                <% if @stats[:top_genres].any? %>
                  <% @stats[:top_genres].first(3).each_with_index do |g, idx| %>
                    <div>
                      <div class="flex justify-between text-[11px] font-semibold text-zinc-300 mb-0.5">
                        <span class="truncate"><%= g[:name] %></span>
                        <span class="text-zinc-400 ml-1 font-mono">%<%= g[:percentage] %></span>
                      </div>
                      <div class="w-full h-1 rounded-full bg-zinc-800 overflow-hidden">
                        <% bar_color = ['bg-purple-500', 'bg-blue-500', 'bg-emerald-500'][idx % 3] %>
                        <div class="h-full rounded-full <%= bar_color %>" style="width: <%= [g[:percentage] * 2, 100].min %>%;"></div>
                      </div>
                    </div>
                  <% end %>
                <% else %>
                  <p class="text-[11px] text-zinc-500">Tür verisi henüz yok.</p>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6" id="watched_items_container">
        <% @watched_items.each do |item| %>
          <% media_url = item.media_type == 'tv' ? tv_show_path(item.tmdb_id) : movie_path(item.tmdb_id) %>
          <div id="watchlist_card_<%= item.id %>" class="group relative bg-[#121217] rounded-2xl border border-zinc-800/80 overflow-hidden hover:border-purple-500/50 hover:shadow-[0_0_25px_rgba(168,85,247,0.2)] transition-all duration-300 flex flex-col">
            <!-- Poster Area with Aspect 2/3 -->
            <div class="relative aspect-[2/3] w-full overflow-hidden bg-zinc-900">
              <% if item.poster_path.present? %>
                <img src="<%= TmdbService.poster_url(item.poster_path) %>" alt="<%= item.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy">
              <% else %>
                <div class="w-full h-full flex flex-col items-center justify-center text-zinc-600 text-xs gap-2">
                  <span class="text-2xl">🎬</span>
                  <span>Afiş Yok</span>
                </div>
              <% end %>

              <!-- Badges Overlay -->
              <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5 z-10 pointer-events-none">
                <span class="px-2 py-0.5 text-[10px] font-bold uppercase rounded-lg bg-black/60 backdrop-blur-md text-purple-300 border border-purple-500/30 shadow">
                  <%= item.media_type == 'tv' ? 'Dizi' : 'Film' %>
                </span>
              </div>

              <% if item.user_rating.present? %>
                <div class="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-lg bg-black/60 backdrop-blur-md border border-amber-400/30 flex items-center gap-1 text-amber-400 text-xs font-bold shadow z-10">
                  <span>★</span>
                  <span><%= item.user_rating %></span>
                </div>
              <% end %>

              <!-- Hover Delete Action -->
              <div class="absolute top-2.5 right-2.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-20 <%= 'mt-7' if item.user_rating.present? %>">
                <%= button_to watchlist_path(item), method: :delete, class: "p-1.5 rounded-lg bg-black/80 hover:bg-red-500/80 text-zinc-300 hover:text-white border border-zinc-700/60 hover:border-red-500/50 transition cursor-pointer shadow-lg", title: "Listeden Kaldır" do %>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                <% end %>
              </div>

              <!-- Bottom Dark Gradient with Info -->
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0a0a0c] via-[#0a0a0c]/85 to-transparent p-3 sm:p-3.5 pt-12 flex flex-col justify-end">
                <h3 class="text-xs sm:text-sm font-bold text-white group-hover:text-purple-300 transition-colors line-clamp-1">
                  <%= link_to item.title, media_url %>
                </h3>
                <div class="flex items-center justify-between text-[11px] text-emerald-400 font-medium mt-1">
                  <span class="flex items-center gap-1">
                    <svg class="w-3 h-3 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <span><%= item.watched_at ? item.watched_at.strftime("%d.%m.%Y") : "İzlendi" %></span>
                  </span>
                </div>
              </div>
            </div>

            <!-- Card Bottom Bar: Quick Rating & Recommendation Link -->
            <div class="p-2.5 bg-[#121217] border-t border-zinc-800/80 space-y-1.5">
              <%= form_with model: item, method: :patch, class: "flex items-center gap-1.5 w-full" do |f| %>
                <%= f.select :user_rating, (1..10).map { |r| ["★ #{r}", r] }, { selected: item.user_rating, include_blank: "Puan Değiştir" }, class: "text-xs bg-zinc-900 border border-zinc-800 rounded-xl px-2.5 py-1.5 text-zinc-200 focus:outline-none focus:border-purple-500 w-full transition cursor-pointer", onchange: "this.form.requestSubmit()" %>
              <% end %>

              <%= link_to watchlists_path(tab: "recommendations", source_id: item.tmdb_id), class: "w-full py-1.5 px-2 rounded-xl bg-purple-600/10 hover:bg-purple-600/25 border border-purple-500/25 text-purple-300 hover:text-white text-[11px] font-semibold flex items-center justify-center gap-1.5 transition duration-150" do %>
                <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span>Benzerlerini Öner</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% elsif @active_tab == "recommendations" %>
    <% if @watched_items.empty? %>
      <div class="text-center py-20 bg-[#121217] rounded-3xl border border-zinc-800/80 p-8 shadow-xl">
        <div class="w-16 h-16 rounded-2xl bg-purple-600/10 border border-purple-500/20 text-purple-400 flex items-center justify-center mx-auto mb-4 text-2xl">
          ✨
        </div>
        <h3 class="text-lg font-bold text-white">Henüz izlediğiniz bir yapım yok</h3>
        <p class="text-xs sm:text-sm text-zinc-400 max-w-md mx-auto mt-2 leading-relaxed">
          Kişiselleştirilmiş film ve dizi önerileri alabilmek için daha önce izlediğiniz veya beğendiğiniz yapımları "İzledim" olarak işaretleyin.
        </p>
        <div class="mt-6">
          <%= link_to "Kataloğu Keşfet", root_path, class: "px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold shadow-lg shadow-purple-600/25 transition duration-200 inline-block" %>
        </div>
      </div>
    <% else %>
      <div class="space-y-6">
        <!-- Interactive Source Switcher Bar -->
        <div class="bg-[#121217] border border-purple-500/20 rounded-2xl p-4 sm:p-5 shadow-xl flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-purple-600/25 to-purple-950/40 border border-purple-500/30 flex items-center justify-center text-purple-400 shrink-0 shadow-inner">
              <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h2 class="text-base sm:text-lg font-bold text-white tracking-tight">Öneri Temeli</h2>
                <span class="px-2.5 py-0.5 text-xs font-bold rounded-lg bg-purple-600/20 text-purple-300 border border-purple-500/30">
                  <%= @source_title %>
                </span>
                <% if @source_id == 'all' %>
                  <span class="px-2 py-0.5 text-[10px] font-semibold rounded-md bg-zinc-800 text-zinc-300">
                    <%= @watched_items.count %> izlenen yapım
                  </span>
                <% end %>
              </div>
              <p class="text-xs text-zinc-400 mt-0.5">
                <% if @source_id == 'all' %>
                  İzleme geçmişinizdeki farklı filmlerden dengeli (interleaved) harmanlanmış öneriler.
                <% else %>
                  Bu öneriler seçtiğiniz yapımın tür, konu ve benzerlik algoritmasına göre oluşturulmuştur.
                <% end %>
              </p>
            </div>
          </div>

          <!-- Actions: Refresh Mix & Switch Source Dropdown -->
          <div class="flex items-center gap-2.5 flex-wrap self-start md:self-auto shrink-0">
            <% if @source_id == 'all' && @watched_items.count > 4 %>
              <%= link_to watchlists_path(tab: "recommendations", source_id: "all"), onclick: "this.href = '#{watchlists_path(tab: 'recommendations', source_id: 'all')}&refresh=' + Date.now()", class: "px-3 py-2 rounded-xl bg-purple-600/20 hover:bg-purple-600/35 border border-purple-500/40 text-purple-200 text-xs font-semibold flex items-center gap-1.5 transition active:scale-95 shadow-sm", title: "Farklı izlediğiniz filmlerden yeni bir karışım oluştur" do %>
                <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Karışımı Yenile</span>
              <% end %>
            <% end %>

            <div class="flex items-center gap-2">
              <label for="recommendation_source_select" class="text-xs font-semibold text-zinc-400">Kaynak Film:</label>
              <select id="recommendation_source_select" onchange="window.location.href = '<%= watchlists_path(tab: 'recommendations') %>' + '&source_id=' + this.value" class="bg-zinc-900 border border-zinc-700 text-zinc-200 text-xs rounded-xl px-3 py-2 focus:outline-none focus:border-purple-500 transition cursor-pointer max-w-[260px] sm:max-w-xs shadow-inner">
                <option value="all" <%= 'selected' if @source_id == 'all' %>>🎲 Tüm İzlediklerimden Karma (<%= @watched_items.count %> Film)</option>
                <optgroup label="İzlediğiniz Filmler & Diziler">
                  <% @watched_items.each do |w| %>
                    <option value="<%= w.tmdb_id %>" <%= 'selected' if @source_id.to_s == w.tmdb_id.to_s %>>
                      <%= w.title %> <%= "(★#{w.user_rating})" if w.user_rating.present? %>
                    </option>
                  <% end %>
                </optgroup>
              </select>
            </div>
          </div>
        </div>

        <!-- Quick Source Select Chips Bar -->
        <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-thin">
          <span class="text-xs text-zinc-500 shrink-0 font-semibold uppercase tracking-wider">Hızlı Seçim:</span>
          <%= link_to watchlists_path(tab: "recommendations", source_id: "all"), class: "px-3 py-1.5 rounded-xl text-xs font-semibold transition shrink-0 flex items-center gap-1.5 #{@source_id == 'all' ? 'bg-purple-600 text-white shadow-md shadow-purple-600/25' : 'bg-zinc-900 text-zinc-400 hover:text-white hover:bg-zinc-800 border border-zinc-800'}" do %>
            <span>🎲 Karma Algoritma</span>
          <% end %>
          <% @watched_items.first(8).each do |w| %>
            <%= link_to watchlists_path(tab: "recommendations", source_id: w.tmdb_id), class: "px-3 py-1.5 rounded-xl text-xs font-semibold transition shrink-0 flex items-center gap-1.5 #{@source_id.to_s == w.tmdb_id.to_s ? 'bg-purple-600 text-white shadow-md shadow-purple-600/25' : 'bg-zinc-900 text-zinc-400 hover:text-white hover:bg-zinc-800 border border-zinc-800'}" do %>
              <span class="truncate max-w-[130px] sm:max-w-[180px]"><%= w.title %></span>
              <% if w.user_rating.present? %>
                <span class="text-amber-400 text-[10px] font-bold">★<%= w.user_rating %></span>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <!-- Recommendations Grid -->
        <% if @recommendations.empty? %>
          <div class="text-center py-16 bg-[#121217] rounded-3xl border border-zinc-800/80 p-8 shadow-xl">
            <div class="w-16 h-16 rounded-2xl bg-purple-600/10 border border-purple-500/20 text-purple-400 flex items-center justify-center mx-auto mb-4 text-2xl">
              🔍
            </div>
            <h3 class="text-lg font-bold text-white">Bu yapıma uygun yeni öneri bulunamadı</h3>
            <p class="text-xs sm:text-sm text-zinc-400 max-w-sm mx-auto mt-2 leading-relaxed">
              Yukarıdaki seçiciden veya hızlı seçim butonlarından izlediğiniz başka bir filmi seçebilirsiniz.
            </p>
          </div>
        <% else %>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3.5 sm:gap-6">
            <% @recommendations.each do |rec| %>
              <%= render "movies/card", item: rec, watchlist_map: @user_watchlist_map %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <% if @plan_to_watch_items.empty? %>
      <div class="text-center py-20 bg-[#121217] rounded-3xl border border-zinc-800/80 p-8 shadow-xl">
        <div class="w-16 h-16 rounded-2xl bg-purple-600/10 border border-purple-500/20 text-purple-400 flex items-center justify-center mx-auto mb-4 text-2xl">
          📌
        </div>
        <h3 class="text-lg font-bold text-white">İzleme listeniz şu an boş</h3>
        <p class="text-xs sm:text-sm text-zinc-400 max-w-sm mx-auto mt-2 leading-relaxed">
          İzlemek istediğiniz film ve dizileri listenize ekleyerek ne zaman isterseniz takip edebilirsiniz.
        </p>
        <div class="mt-6">
          <%= link_to "Kataloğa Göz At", root_path, class: "px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold shadow-lg shadow-purple-600/25 transition duration-200 inline-block" %>
        </div>
      </div>
    <% else %>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6" id="plan_to_watch_container">
        <% @plan_to_watch_items.each do |item| %>
          <% media_url = item.media_type == 'tv' ? tv_show_path(item.tmdb_id) : movie_path(item.tmdb_id) %>
          <div id="watchlist_card_<%= item.id %>" class="group relative bg-[#121217] rounded-2xl border border-zinc-800/80 overflow-hidden hover:border-purple-500/50 hover:shadow-[0_0_25px_rgba(168,85,247,0.2)] transition-all duration-300 flex flex-col">
            <!-- Poster Area with Aspect 2/3 -->
            <div class="relative aspect-[2/3] w-full overflow-hidden bg-zinc-900">
              <% if item.poster_path.present? %>
                <img src="<%= TmdbService.poster_url(item.poster_path) %>" alt="<%= item.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy">
              <% else %>
                <div class="w-full h-full flex flex-col items-center justify-center text-zinc-600 text-xs gap-2">
                  <span class="text-2xl">🎬</span>
                  <span>Afiş Yok</span>
                </div>
              <% end %>

              <!-- Badges Overlay -->
              <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5 z-10 pointer-events-none">
                <span class="px-2 py-0.5 text-[10px] font-bold uppercase rounded-lg bg-black/60 backdrop-blur-md text-purple-300 border border-purple-500/30 shadow">
                  <%= item.media_type == 'tv' ? 'Dizi' : 'Film' %>
                </span>
              </div>

              <!-- Hover Delete Action -->
              <div class="absolute top-2.5 right-2.5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-20">
                <%= button_to watchlist_path(item), method: :delete, class: "p-1.5 rounded-lg bg-black/80 hover:bg-red-500/80 text-zinc-300 hover:text-white border border-zinc-700/60 hover:border-red-500/50 transition cursor-pointer shadow-lg", title: "Listeden Kaldır" do %>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                <% end %>
              </div>

              <!-- Bottom Dark Gradient with Info -->
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0a0a0c] via-[#0a0a0c]/85 to-transparent p-3 sm:p-3.5 pt-12 flex flex-col justify-end">
                <h3 class="text-xs sm:text-sm font-bold text-white group-hover:text-purple-300 transition-colors line-clamp-1">
                  <%= link_to item.title, media_url %>
                </h3>
                <div class="flex items-center justify-between text-[11px] text-zinc-400 font-medium mt-1">
                  <span class="flex items-center gap-1">
                    <svg class="w-3 h-3 text-purple-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span><%= item.created_at.strftime("%d.%m.%Y") %></span>
                  </span>
                </div>
              </div>
            </div>

            <!-- Card Bottom Bar: Mark as Watched -->
            <div class="p-2.5 bg-[#121217] border-t border-zinc-800/80">
              <%= form_with model: item, method: :patch, class: "w-full" do |f| %>
                <%= f.hidden_field :status, value: "watched" %>
                <%= f.submit "İzledim ✓", class: "w-full py-1.5 text-xs font-semibold rounded-xl bg-purple-600 hover:bg-purple-500 text-white cursor-pointer transition shadow-md shadow-purple-600/20 text-center" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
