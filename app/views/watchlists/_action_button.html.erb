<%# locals: (tmdb_id:, media_type:, title:, poster_path:, watchlist_item: nil, compact: false, hero: false) %>
<div id="watchlist_action_<%= tmdb_id %>_<%= media_type %>" class="watchlist-action-container <%= hero ? 'inline-block' : 'w-full' %>">
  <% if !user_signed_in? %>
    <% if hero %>
      <%= link_to new_user_session_path, class: "bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-200 border border-zinc-700/60 backdrop-blur-md px-5 py-3 rounded-xl font-medium transition-all inline-flex items-center gap-2 text-sm shadow-sm" do %>
        <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Listeme Ekle</span>
      <% end %>
    <% else %>
      <%= link_to new_user_session_path, class: "w-full inline-flex items-center justify-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-xl bg-[#1c1d25] hover:bg-[#252333] text-[#8b90a0] hover:text-[#f1f3f7] border border-[#262833] transition duration-150" do %>
        <svg class="w-3.5 h-3.5 text-[#a78bfa]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span><%= compact ? "+ Listeme Ekle" : "İzleme Listeme Ekle" %></span>
      <% end %>
    <% end %>
  <% elsif watchlist_item.present? %>
    <% if watchlist_item.watched? %>
      <!-- Already Watched State -->
      <div class="flex items-center <%= hero ? 'gap-2.5' : 'justify-between w-full gap-1.5' %>">
        <div class="inline-flex items-center gap-1.5 <%= hero ? 'px-4 py-3 text-sm rounded-xl bg-purple-600/20 text-purple-300 border border-purple-500/30 backdrop-blur-md font-semibold' : 'px-2.5 py-1 text-[11px] sm:text-xs font-semibold rounded-lg bg-[#272236] text-[#a78bfa] border border-[#a78bfa]/30 truncate' %>">
          <svg class="w-3.5 h-3.5 text-purple-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span class="truncate">İzlendi</span>
          <% if watchlist_item.user_rating.present? %>
            <span class="text-amber-400 font-bold shrink-0">★<%= watchlist_item.user_rating %></span>
          <% end %>
        </div>

        <!-- Remove Button -->
        <%= button_to watchlist_path(watchlist_item), method: :delete, class: "#{hero ? 'p-3 bg-zinc-900/60 hover:bg-red-500/20 text-zinc-400 hover:text-red-400 border border-zinc-700/60 rounded-xl backdrop-blur-md' : 'p-1.5 text-[#8b90a0] hover:text-red-400 hover:bg-red-500/10 rounded-lg'} transition text-xs cursor-pointer shrink-0", title: "Listeden Kaldır" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        <% end %>
      </div>
    <% else %>
      <!-- Plan to Watch State -->
      <div class="flex items-center <%= hero ? 'gap-2.5' : 'justify-between w-full gap-1.5' %>">
        <span class="inline-flex items-center gap-1.5 <%= hero ? 'px-4 py-3 text-sm rounded-xl bg-purple-600/20 text-purple-300 border border-purple-500/30 backdrop-blur-md font-semibold' : 'px-2 py-1 text-[11px] sm:text-xs font-semibold rounded-lg bg-[#272236] text-[#a78bfa] border border-[#a78bfa]/25 truncate' %>">
          ✓ Listede
        </span>

        <div class="flex items-center gap-1.5">
          <!-- Quick Mark as Watched Form -->
          <%= form_with model: watchlist_item, method: :patch, class: "inline-flex items-center gap-1" do |f| %>
            <%= f.hidden_field :status, value: "watched" %>
            <button type="submit" class="<%= hero ? 'bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-200 border border-zinc-700/60 backdrop-blur-md px-4 py-3 rounded-xl font-medium text-sm' : 'px-2 py-1 text-[11px] sm:text-xs font-semibold rounded-lg bg-[#6d28d9] hover:bg-[#5b21b6] text-white' %> cursor-pointer transition shadow-sm">
              İzledim
            </button>
          <% end %>

          <%= button_to watchlist_path(watchlist_item), method: :delete, class: "#{hero ? 'p-3 bg-zinc-900/60 hover:bg-red-500/20 text-zinc-400 hover:text-red-400 border border-zinc-700/60 rounded-xl backdrop-blur-md' : 'p-1.5 text-[#8b90a0] hover:text-red-400 hover:bg-red-500/10 rounded-lg'} transition text-xs cursor-pointer", title: "Kaldır" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <!-- Not in Watchlist State -->
    <% if hero %>
      <div class="flex items-center gap-3">
        <!-- Add to Plan to Watch -->
        <%= form_with url: watchlists_path, method: :post, class: "inline" do |f| %>
          <%= f.hidden_field "watchlist[tmdb_id]", value: tmdb_id %>
          <%= f.hidden_field "watchlist[media_type]", value: media_type %>
          <%= f.hidden_field "watchlist[title]", value: title %>
          <%= f.hidden_field "watchlist[poster_path]", value: poster_path %>
          <%= f.hidden_field "watchlist[status]", value: "plan_to_watch" %>

          <button type="submit" class="bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-200 border border-zinc-700/60 backdrop-blur-md px-5 py-3 rounded-xl font-medium transition-all inline-flex items-center gap-2 text-sm shadow-sm cursor-pointer">
            <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>İzleyeceğim</span>
          </button>
        <% end %>

        <!-- Direct Mark Watched -->
        <%= form_with url: watchlists_path, method: :post, class: "inline" do |f| %>
          <%= f.hidden_field "watchlist[tmdb_id]", value: tmdb_id %>
          <%= f.hidden_field "watchlist[media_type]", value: media_type %>
          <%= f.hidden_field "watchlist[title]", value: title %>
          <%= f.hidden_field "watchlist[poster_path]", value: poster_path %>
          <%= f.hidden_field "watchlist[status]", value: "watched" %>

          <button type="submit" class="bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-200 border border-zinc-700/60 backdrop-blur-md px-5 py-3 rounded-xl font-medium transition-all inline-flex items-center gap-2 text-sm shadow-sm cursor-pointer">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>İzledim</span>
          </button>
        <% end %>
      </div>
    <% else %>
      <div class="flex items-center gap-1.5 w-full">
        <!-- Add to Plan to Watch -->
        <%= form_with url: watchlists_path, method: :post, class: "flex-1" do |f| %>
          <%= f.hidden_field "watchlist[tmdb_id]", value: tmdb_id %>
          <%= f.hidden_field "watchlist[media_type]", value: media_type %>
          <%= f.hidden_field "watchlist[title]", value: title %>
          <%= f.hidden_field "watchlist[poster_path]", value: poster_path %>
          <%= f.hidden_field "watchlist[status]", value: "plan_to_watch" %>

          <button type="submit" class="w-full inline-flex items-center justify-center gap-1 px-2 py-1.5 text-[11px] sm:text-xs font-medium rounded-lg bg-[#1c1d25] hover:bg-[#252333] text-[#f1f3f7] border border-[#262833] hover:border-[#a78bfa]/40 transition duration-150 cursor-pointer shadow-sm">
            <svg class="w-3 h-3 text-[#a78bfa] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span class="truncate"><%= compact ? "+ Liste" : "İzleyeceğim" %></span>
          </button>
        <% end %>

        <!-- Direct Mark Watched -->
        <%= form_with url: watchlists_path, method: :post, class: "flex-1" do |f| %>
          <%= f.hidden_field "watchlist[tmdb_id]", value: tmdb_id %>
          <%= f.hidden_field "watchlist[media_type]", value: media_type %>
          <%= f.hidden_field "watchlist[title]", value: title %>
          <%= f.hidden_field "watchlist[poster_path]", value: poster_path %>
          <%= f.hidden_field "watchlist[status]", value: "watched" %>

          <button type="submit" class="w-full inline-flex items-center justify-center gap-1 px-2 py-1.5 text-[11px] sm:text-xs font-semibold rounded-lg bg-[#272236] hover:bg-[#6d28d9] text-[#a78bfa] hover:text-white border border-[#a78bfa]/30 transition duration-150 cursor-pointer shadow-sm">
            <svg class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="truncate">İzledim</span>
          </button>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
