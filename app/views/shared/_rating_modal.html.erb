<div id="rating-modal" data-controller="rating-modal" data-rating-modal-target="modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 overflow-y-auto">
  <!-- Backdrop -->
  <div data-action="click->rating-modal#close" class="fixed inset-0 bg-black/80 backdrop-blur-md transition-opacity"></div>

  <!-- Dialog Panel -->
  <div class="relative bg-[#15161c] border border-zinc-800/90 rounded-3xl shadow-[0_0_50px_rgba(0,0,0,0.8)] max-w-md w-full p-5 sm:p-6 text-white z-10 flex flex-col gap-5 border-t border-t-purple-500/30">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-7 h-7 rounded-lg bg-purple-600/20 border border-purple-500/30 text-purple-400 flex items-center justify-center text-sm font-bold">
          ★
        </span>
        <span class="text-xs font-bold uppercase tracking-wider text-purple-400">İzleme Günlüğü</span>
      </div>
      <button type="button" data-action="click->rating-modal#close" class="p-1.5 rounded-xl text-zinc-400 hover:text-white hover:bg-zinc-800 transition cursor-pointer" title="Kapat">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Media Summary Card -->
    <div class="flex items-center gap-3.5 p-3 rounded-2xl bg-[#0d0e12] border border-zinc-800/80">
      <div class="w-12 h-16 sm:w-14 sm:h-20 rounded-xl overflow-hidden bg-zinc-900 shrink-0 border border-zinc-800 flex items-center justify-center">
        <img data-rating-modal-target="posterDisplay" src="" alt="Afiş" class="w-full h-full object-cover hidden">
        <div data-rating-modal-target="posterFallback" class="text-xl text-zinc-600">🎬</div>
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1">
          <span data-rating-modal-target="mediaTypeBadge" class="px-2 py-0.5 text-[10px] font-bold uppercase rounded-md bg-purple-950/80 text-purple-300 border border-purple-800/40">
            Film
          </span>
          <span class="text-[11px] text-emerald-400 font-semibold flex items-center gap-1">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            İzlendi
          </span>
        </div>
        <h3 data-rating-modal-target="titleDisplay" class="font-bold text-sm sm:text-base text-white truncate">
          Yapım Başlığı
        </h3>
        <p class="text-[11px] text-zinc-400 mt-0.5">Bu yapıma puan vermek ister misiniz?</p>
      </div>
    </div>

    <!-- Rating Section -->
    <div class="flex flex-col items-center gap-3 py-1">
      <!-- Stars (1 - 10) -->
      <div class="flex items-center justify-between w-full max-w-sm px-1" data-rating-modal-target="starsContainer" data-action="mouseleave->rating-modal#resetHover">
        <% (1..10).each do |score| %>
          <button type="button"
            data-rating-modal-target="star"
            data-rating="<%= score %>"
            data-action="mouseenter->rating-modal#hoverStar click->rating-modal#selectStar"
            class="p-1 sm:p-1.5 text-zinc-600 hover:text-amber-400 transition-all duration-150 transform hover:scale-125 focus:outline-none cursor-pointer"
            title="<%= score %> / 10">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 transition-colors" viewBox="0 0 24 24" fill="currentColor" stroke="none">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </button>
        <% end %>
      </div>

      <!-- Rating Live Feedback -->
      <div data-rating-modal-target="ratingFeedback" class="text-xs sm:text-sm font-medium text-zinc-400 min-h-[20px] transition-all">
        Puan vermek için yıldız seçin (1-10)
      </div>
    </div>

    <!-- Form for Submission -->
    <%= form_with url: watchlists_path, method: :post, id: "rating_modal_form", data: { "rating-modal-target": "form", action: "submit->rating-modal#submitRating" }, class: "flex flex-col gap-2.5 w-full mt-1" do |f| %>
      <input type="hidden" name="_method" value="post" data-rating-modal-target="formMethod">
      <input type="hidden" name="watchlist[tmdb_id]" value="" data-rating-modal-target="tmdbIdInput">
      <input type="hidden" name="watchlist[media_type]" value="movie" data-rating-modal-target="mediaTypeInput">
      <input type="hidden" name="watchlist[title]" value="" data-rating-modal-target="titleInput">
      <input type="hidden" name="watchlist[poster_path]" value="" data-rating-modal-target="posterPathInput">
      <input type="hidden" name="watchlist[status]" value="watched" data-rating-modal-target="statusInput">
      <input type="hidden" name="watchlist[user_rating]" value="" data-rating-modal-target="ratingInput">

      <!-- Submit With Rating Button -->
      <button type="submit"
        data-rating-modal-target="submitRatingBtn"
        class="w-full py-3 px-4 rounded-xl font-bold text-xs sm:text-sm bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white shadow-lg shadow-purple-600/30 transition duration-150 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2">
        <span data-rating-modal-target="submitRatingText">Puanla ve Kaydet</span>
      </button>

      <!-- Submit Without Rating Button -->
      <button type="button"
        data-action="click->rating-modal#submitWithoutRating"
        class="w-full py-2.5 px-4 rounded-xl font-medium text-xs sm:text-sm bg-[#1c1d25] hover:bg-[#252333] text-zinc-300 hover:text-white border border-[#262833] transition duration-150 cursor-pointer text-center">
        Puansız İzledim Olarak Kaydet
      </button>

      <!-- Cancel Action -->
      <div class="text-center mt-1">
        <button type="button" data-action="click->rating-modal#close" class="text-xs text-zinc-500 hover:text-zinc-300 transition cursor-pointer">
          Vazgeç
        </button>
      </div>
    <% end %>
  </div>
</div>
