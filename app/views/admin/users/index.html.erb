<% content_for :title, "Kullanıcı Yönetimi — Yönetici Paneli" %>

<%= render "admin/shared/header" %>

<!-- Search & Filters Bar -->
<div class="p-4 rounded-2xl bg-[#121217]/80 border border-zinc-800/80 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <%= form_with url: admin_users_path, method: :get, class: "flex items-center gap-2 flex-1 max-w-md", data: { turbo_frame: "_top" } do |f| %>
    <div class="relative flex-1">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <%= f.text_field :query, value: params[:query], placeholder: "Kullanıcı adı veya e-posta ara...", class: "w-full pl-9 pr-4 py-2 text-xs sm:text-sm bg-zinc-900 border border-zinc-800 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:border-purple-500" %>
    </div>
    <%= f.submit "Ara", class: "px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold rounded-xl cursor-pointer transition" %>
    <% if params[:query].present? || params[:role].present? %>
      <%= link_to "Sıfırla", admin_users_path, class: "px-3 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-medium rounded-xl transition" %>
    <% end %>
  <% end %>

  <div class="flex items-center gap-2 text-xs">
    <span class="text-zinc-500">Filtre:</span>
    <%= link_to "Tümü", admin_users_path(query: params[:query]), class: "px-2.5 py-1 rounded-lg #{params[:role].blank? ? 'bg-purple-600/20 text-purple-300 font-bold' : 'text-zinc-400 hover:text-white'}" %>
    <%= link_to "Yöneticiler", admin_users_path(role: "admin", query: params[:query]), class: "px-2.5 py-1 rounded-lg #{params[:role] == 'admin' ? 'bg-purple-600/20 text-purple-300 font-bold' : 'text-zinc-400 hover:text-white'}" %>
    <%= link_to "Normal Kullanıcılar", admin_users_path(role: "user", query: params[:query]), class: "px-2.5 py-1 rounded-lg #{params[:role] == 'user' ? 'bg-purple-600/20 text-purple-300 font-bold' : 'text-zinc-400 hover:text-white'}" %>
  </div>
</div>

<!-- Users Table -->
<div class="p-6 rounded-2xl bg-[#121217]/80 border border-zinc-800/80 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs">
      <thead>
        <tr class="border-b border-zinc-800 text-zinc-400">
          <th class="pb-3 font-semibold">Kullanıcı</th>
          <th class="pb-3 font-semibold">E-posta</th>
          <th class="pb-3 font-semibold">Yetki</th>
          <th class="pb-3 font-semibold">Giriş Türü</th>
          <th class="pb-3 font-semibold text-center">İzleme Listesi</th>
          <th class="pb-3 font-semibold text-center">Gönderiler</th>
          <th class="pb-3 font-semibold">Kayıt Tarihi</th>
          <th class="pb-3 font-semibold text-right">İşlemler</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-800/60">
        <% @users.each do |user| %>
          <tr class="hover:bg-zinc-900/40 transition">
            <td class="py-3.5">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-purple-700 to-purple-900 border border-purple-500/30 flex items-center justify-center text-xs font-black text-white shrink-0">
                  <%= user.username[0].upcase %>
                </div>
                <div>
                  <%= link_to user.username, admin_user_path(user), class: "font-bold text-white hover:text-purple-400 transition" %>
                  <% if user == current_user %>
                    <span class="ml-1 text-[10px] text-zinc-500">(Siz)</span>
                  <% end %>
                </div>
              </div>
            </td>
            <td class="py-3.5 text-zinc-300">
              <%= user.email %>
            </td>
            <td class="py-3.5">
              <% if user.admin? %>
                <span class="px-2 py-0.5 text-[10px] font-black uppercase tracking-wider rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30">Yönetici</span>
              <% else %>
                <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-zinc-800 text-zinc-400">Kullanıcı</span>
              <% end %>
            </td>
            <td class="py-3.5 text-zinc-400">
              <% if user.provider == 'google_oauth2' %>
                <span class="inline-flex items-center gap-1 text-[11px] text-zinc-300">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Google
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1 text-[11px] text-zinc-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span> E-posta/Şifre
                </span>
              <% end %>
            </td>
            <td class="py-3.5 text-center font-semibold text-zinc-300">
              <%= user.watchlists.count %>
            </td>
            <td class="py-3.5 text-center font-semibold text-zinc-300">
              <%= user.community_posts.count %>
            </td>
            <td class="py-3.5 text-zinc-400">
              <%= user.created_at.strftime("%d.%m.%Y %H:%M") %>
            </td>
            <td class="py-3.5 text-right">
              <div class="flex items-center justify-end gap-1.5">
                <%= link_to admin_user_path(user), class: "p-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white transition", title: "Profili İncele" do %>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                <% end %>

                <% unless user == current_user %>
                  <%= button_to toggle_admin_admin_user_path(user), method: :patch, data: { turbo_confirm: user.admin? ? "#{user.username} kullanıcısının yöneticilik yetkisini almak istiyor musunuz?" : "#{user.username} kullanıcısını yönetici yapmak istiyor musunuz?" }, class: "p-2 rounded-lg #{user.admin? ? 'bg-amber-500/10 hover:bg-amber-500/20 text-amber-400' : 'bg-purple-600/15 hover:bg-purple-600/30 text-purple-300'} transition cursor-pointer", title: user.admin? ? "Yöneticiliği Kaldır" : "Yönetici Yap" do %>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  <% end %>

                  <%= button_to admin_user_path(user), method: :delete, data: { turbo_confirm: "#{user.username} kullanıcısını ve tüm verilerini silmek istediğinizden emin misiniz? Bu işlem geri alınamaz!" }, class: "p-2 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 transition cursor-pointer", title: "Kullanıcıyı Sil" do %>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
