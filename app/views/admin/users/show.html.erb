<% content_for :title, "#{@user.username} — Kullanıcı Detayı — Yönetici Paneli" %>

<%= render "admin/shared/header" %>

<div class="mb-6">
  <%= link_to "← Kullanıcılar Listesine Dön", admin_users_path, class: "text-xs font-semibold text-zinc-400 hover:text-white transition flex items-center gap-1.5" %>
</div>

<!-- User Profile Card -->
<div class="p-6 rounded-2xl bg-[#121217]/80 border border-zinc-800/80 mb-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-6 border-b border-zinc-800">
    <div class="flex items-center gap-4">
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-700 to-purple-900 border border-purple-500/30 flex items-center justify-center text-2xl font-black text-white shadow-lg">
        <%= @user.username[0].upcase %>
      </div>
      <div>
        <div class="flex items-center gap-2.5">
          <h2 class="text-xl font-bold text-white"><%= @user.username %></h2>
          <% if @user.admin? %>
            <span class="px-2 py-0.5 text-[10px] font-black uppercase tracking-wider rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30">Yönetici</span>
          <% end %>
        </div>
        <p class="text-sm text-zinc-400 mt-0.5"><%= @user.email %></p>
        <p class="text-xs text-zinc-500 mt-1">Kayıt: <%= @user.created_at.strftime("%d.%m.%Y %H:%M") %> (<%= time_ago_in_words(@user.created_at) %> önce)</p>
      </div>
    </div>

    <% unless @user == current_user %>
      <div class="flex items-center gap-3">
        <%= button_to toggle_admin_admin_user_path(@user), method: :patch, data: { turbo_confirm: @user.admin? ? "Yöneticilik yetkisini almak istiyor musunuz?" : "Yönetici yapmak istiyor musunuz?" }, class: "px-4 py-2 rounded-xl text-xs font-semibold #{@user.admin? ? 'bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-purple-600/20 hover:bg-purple-600/30 text-purple-300 border border-purple-500/40'} transition cursor-pointer" do %>
          <%= @user.admin? ? "Yöneticiliği Kaldır" : "Yönetici Yetkisi Ver" %>
        <% end %>

        <%= button_to admin_user_path(@user), method: :delete, data: { turbo_confirm: "#{@user.username} kullanıcısını silmek istediğinizden emin misiniz? Tüm verileri kalıcı olarak silinecek!" }, class: "px-4 py-2 rounded-xl text-xs font-semibold bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 transition cursor-pointer" do %>
          Kullanıcıyı Sil
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 text-xs">
    <div>
      <span class="text-zinc-500 block mb-1">Giriş Sağlayıcı</span>
      <span class="font-semibold text-white"><%= @user.provider.presence || "Standart (Şifre)" %></span>
    </div>
    <div>
      <span class="text-zinc-500 block mb-1">Kullanıcı ID</span>
      <span class="font-mono text-zinc-300">#<%= @user.id %></span>
    </div>
    <div>
      <span class="text-zinc-500 block mb-1">İzleme Listesi</span>
      <span class="font-semibold text-purple-400"><%= @user.watchlists.count %> film/dizi</span>
    </div>
    <div>
      <span class="text-zinc-500 block mb-1">Topluluk Paylaşımı</span>
      <span class="font-semibold text-emerald-400"><%= @user.community_posts.count %> gönderi</span>
    </div>
  </div>
</div>

<!-- User's Watchlists & Posts Grid -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
  <!-- Watchlists -->
  <div class="p-6 rounded-2xl bg-[#121217]/80 border border-zinc-800/80">
    <h3 class="text-sm font-bold text-white mb-4 flex items-center justify-between">
      <span>İzleme Listesi (<%= @user.watchlists.count %>)</span>
    </h3>
    <div class="space-y-3 max-h-[500px] overflow-y-auto pr-1">
      <% if @watchlists.any? %>
        <% @watchlists.each do |w| %>
          <div class="flex items-center justify-between p-3 rounded-xl bg-zinc-900/60 border border-zinc-800/60 text-xs">
            <div class="flex items-center gap-2.5 min-w-0">
              <% if w.poster_path.present? %>
                <img src="https://image.tmdb.org/t/p/w92<%= w.poster_path %>" alt="" class="w-6 h-9 object-cover rounded shrink-0" />
              <% end %>
              <div class="min-w-0">
                <span class="font-semibold text-white truncate block"><%= w.title %></span>
                <span class="text-[11px] text-zinc-500"><%= w.media_type == 'movie' ? 'Film' : 'Dizi' %> • <%= w.status == 1 ? 'İzlendi' : 'İzlenecek' %></span>
              </div>
            </div>
            <% if w.user_rating.present? %>
              <span class="font-bold text-amber-400 shrink-0">★ <%= w.user_rating %></span>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-xs text-zinc-500 text-center py-6">Kullanıcının henüz izleme kaydı yok.</p>
      <% end %>
    </div>
  </div>

  <!-- Posts -->
  <div class="p-6 rounded-2xl bg-[#121217]/80 border border-zinc-800/80">
    <h3 class="text-sm font-bold text-white mb-4">
      Topluluk Gönderileri (<%= @user.community_posts.count %>)
    </h3>
    <div class="space-y-3 max-h-[500px] overflow-y-auto pr-1">
      <% if @posts.any? %>
        <% @posts.each do |post| %>
          <div class="p-3.5 rounded-xl bg-zinc-900/60 border border-zinc-800/60 text-xs">
            <div class="flex items-center justify-between mb-1.5">
              <%= link_to post.title, admin_community_post_path(post), class: "font-semibold text-white hover:text-purple-400 transition truncate" %>
              <span class="text-[11px] text-zinc-500 shrink-0 pl-2"><%= time_ago_in_words(post.created_at) %></span>
            </div>
            <p class="text-zinc-400 line-clamp-2"><%= post.content %></p>
          </div>
        <% end %>
      <% else %>
        <p class="text-xs text-zinc-500 text-center py-6">Kullanıcının henüz paylaşımı yok.</p>
      <% end %>
    </div>
  </div>
</div>
