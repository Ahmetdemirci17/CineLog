<% content_for :title, "Topluluk Moderasyonu — Yönetici Paneli" %>

<%= render "admin/shared/header" %>

<!-- Search Bar -->
<div class="p-4 rounded-2xl bg-[#121217]/80 border border-zinc-800/80 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <%= form_with url: admin_community_posts_path, method: :get, class: "flex items-center gap-2 flex-1 max-w-md", data: { turbo_frame: "_top" } do |f| %>
    <div class="relative flex-1">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <%= f.text_field :query, value: params[:query], placeholder: "Gönderi başlığı veya içeriğinde ara...", class: "w-full pl-9 pr-4 py-2 text-xs sm:text-sm bg-zinc-900 border border-zinc-800 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:border-purple-500" %>
    </div>
    <%= f.submit "Ara", class: "px-4 py-2 bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold rounded-xl cursor-pointer transition" %>
    <% if params[:query].present? %>
      <%= link_to "Sıfırla", admin_community_posts_path, class: "px-3 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-xs font-medium rounded-xl transition" %>
    <% end %>
  <% end %>
</div>

<!-- Posts List -->
<div class="space-y-4">
  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <div class="p-5 rounded-2xl bg-[#121217]/80 border border-zinc-800/80 hover:border-zinc-700/60 transition">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-xs font-semibold text-purple-400">
                <%= link_to post.user.username, admin_user_path(post.user), class: "hover:underline" %>
              </span>
              <span class="text-zinc-600">•</span>
              <span class="text-xs text-zinc-500"><%= post.created_at.strftime("%d.%m.%Y %H:%M") %> (<%= time_ago_in_words(post.created_at) %> önce)</span>
              <% if post.media_type.present? %>
                <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-zinc-800 text-zinc-400">
                  <%= post.media_type == 'movie' ? 'Film' : 'Dizi' %>
                </span>
              <% end %>
            </div>

            <h2 class="text-base font-bold text-white mb-2">
              <%= link_to post.title, admin_community_post_path(post), class: "hover:text-purple-400 transition" %>
            </h2>
            <p class="text-xs sm:text-sm text-zinc-300 line-clamp-3 leading-relaxed mb-3">
              <%= post.content %>
            </p>

            <div class="flex items-center gap-4 text-xs text-zinc-500">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
                <span><%= post.community_replies.size %> Yanıt</span>
              </span>
            </div>
          </div>

          <div class="flex sm:flex-col items-center sm:items-end gap-2 shrink-0">
            <%= link_to admin_community_post_path(post), class: "px-3 py-1.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-xs font-semibold text-zinc-200 hover:text-white transition flex items-center gap-1.5" do %>
              <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <span>İncele</span>
            <% end %>

            <%= button_to admin_community_post_path(post), method: :delete, data: { turbo_confirm: "\"#{post.title}\" başlıklı gönderiyi silmek istediğinizden emin misiniz? Gönderiye ait tüm yanıtlar da silinecektir." }, class: "px-3 py-1.5 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-xs font-semibold text-red-400 border border-red-500/30 transition cursor-pointer flex items-center gap-1.5" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
              <span>Sil</span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="p-12 rounded-2xl bg-[#121217]/80 border border-zinc-800 text-center">
      <p class="text-sm text-zinc-400">Aranan kriterlere uygun topluluk gönderisi bulunamadı.</p>
    </div>
  <% end %>
</div>
