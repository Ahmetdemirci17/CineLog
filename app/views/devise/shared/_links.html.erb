<div class="space-y-2 text-center text-xs text-[#8b90a0] mt-4">
  <%- if controller_name != 'sessions' %>
    <p><%= link_to "Giriş Yap", new_session_path(resource_name), class: "font-semibold text-[#a78bfa] hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p><%= link_to "Kayıt Ol", new_registration_path(resource_name), class: "font-semibold text-[#a78bfa] hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= link_to "Şifremi Unuttum", new_password_path(resource_name), class: "font-semibold text-[#a78bfa] hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= link_to "Onay talimatlarını almadınız mı?", new_confirmation_path(resource_name), class: "font-semibold text-[#a78bfa] hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p><%= link_to "Kilit açma talimatlarını almadınız mı?", new_unlock_path(resource_name), class: "font-semibold text-[#a78bfa] hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.omniauthable? && !hotwire_native_app? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <p><%= button_to "#{OmniAuth::Utils.camelize(provider)} ile Giriş Yap", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "font-semibold text-[#a78bfa] hover:underline cursor-pointer" %></p>
    <% end %>
  <% end %>
</div>
