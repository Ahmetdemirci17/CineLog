<div class="max-w-md mx-auto py-6 px-4 sm:px-6 space-y-6">
  <div class="bg-[#15161c] p-6 sm:p-8 rounded-2xl border border-[#262833] shadow-md space-y-5">
    <div class="text-center">
      <h2 class="text-2xl font-black text-[#f1f3f7] tracking-tight">Hesabı Düzenle</h2>
      <p class="mt-1 text-xs text-[#8b90a0]">E-posta veya şifre bilgilerinizi güncelleyin.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4", data: { controller: "bridge--form" } }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, "E-posta", class: "block text-xs font-semibold uppercase tracking-wider text-[#8b90a0] mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-3.5 py-2.5 bg-[#1c1d25] border border-[#262833] rounded-xl text-[#f1f3f7] placeholder-[#686d80] focus:outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed] text-xs sm:text-sm transition" %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="text-xs text-amber-300 bg-amber-500/10 border border-amber-500/30 rounded-xl p-3">
          Onay bekleyen e-posta: <%= resource.unconfirmed_email %>
        </div>
      <% end %>

      <div>
        <%= f.label :password, "Yeni Şifre", class: "block text-xs font-semibold uppercase tracking-wider text-[#8b90a0] mb-1" %>
        <p class="text-[11px] text-[#686d80] mb-1.5">Değiştirmek istemiyorsanız boş bırakın<% if @minimum_password_length %> (en az <%= @minimum_password_length %> karakter)<% end %></p>
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-3.5 py-2.5 bg-[#1c1d25] border border-[#262833] rounded-xl text-[#f1f3f7] placeholder-[#686d80] focus:outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed] text-xs sm:text-sm transition" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Yeni Şifre Tekrar", class: "block text-xs font-semibold uppercase tracking-wider text-[#8b90a0] mb-1.5" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-3.5 py-2.5 bg-[#1c1d25] border border-[#262833] rounded-xl text-[#f1f3f7] placeholder-[#686d80] focus:outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed] text-xs sm:text-sm transition" %>
      </div>

      <div>
        <%= f.label :current_password, "Mevcut Şifre", class: "block text-xs font-semibold uppercase tracking-wider text-[#8b90a0] mb-1" %>
        <p class="text-[11px] text-[#686d80] mb-1.5">Değişiklikleri onaylamak için mevcut şifrenizi girin</p>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full px-3.5 py-2.5 bg-[#1c1d25] border border-[#262833] rounded-xl text-[#f1f3f7] placeholder-[#686d80] focus:outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed] text-xs sm:text-sm transition" %>
      </div>

      <%= f.submit "Güncelle", data: { "bridge--form-target": "submit", bridge_title: "Güncelle" }, class: "w-full py-2.5 px-4 bg-[#6d28d9] hover:bg-[#5b21b6] text-white font-semibold rounded-xl text-xs sm:text-sm shadow-sm transition duration-150 cursor-pointer" %>
    <% end %>

    <div class="pt-4 border-t border-[#262833] flex items-center justify-between gap-3">
      <%= link_to "Geri Dön", :back, class: "text-xs font-semibold text-[#8b90a0] hover:text-white transition" %>
      <%= button_to "Hesabımı Sil", registration_path(resource_name), data: { confirm: "Emin misiniz?", turbo_confirm: "Hesabınızı silmek istediğinizden emin misiniz?" }, method: :delete, class: "text-xs font-semibold text-red-400 hover:text-red-300 cursor-pointer" %>
    </div>
  </div>
</div>
