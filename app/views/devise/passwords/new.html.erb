<div class="min-h-[70vh] flex items-center justify-center py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-6 bg-[#15161c] p-7 sm:p-9 rounded-2xl border border-[#262833] shadow-md">
    <div class="text-center">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-[#221e30] border border-[#a78bfa]/25 text-[#a78bfa] mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
        </svg>
      </div>
      <h2 class="text-2xl font-black text-[#f1f3f7] tracking-tight">Şifremi Unuttum</h2>
      <p class="mt-1.5 text-xs text-[#8b90a0]">E-posta adresinizi girin, sıfırlama bağlantısını gönderelim.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-6 space-y-4", data: { controller: "bridge--form" } }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, "E-posta", class: "block text-xs font-semibold uppercase tracking-wider text-[#8b90a0] mb-1.5" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "eposta@example.com", class: "w-full px-3.5 py-2.5 bg-[#1c1d25] border border-[#262833] rounded-xl text-[#f1f3f7] placeholder-[#686d80] focus:outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed] text-xs sm:text-sm transition" %>
      </div>

      <div>
        <%= f.submit "Sıfırlama Bağlantısı Gönder", data: { "bridge--form-target": "submit", bridge_title: "Gönder" }, class: "w-full py-2.5 px-4 bg-[#6d28d9] hover:bg-[#5b21b6] text-white font-semibold rounded-xl text-xs sm:text-sm shadow-sm transition duration-150 cursor-pointer" %>
      </div>
    <% end %>

    <div class="text-center pt-1">
      <p class="text-xs text-[#8b90a0]">
        <%= link_to "Giriş ekranına dön", new_session_path(resource_name), class: "font-semibold text-[#a78bfa] hover:underline" %>
      </p>
    </div>
  </div>
</div>
