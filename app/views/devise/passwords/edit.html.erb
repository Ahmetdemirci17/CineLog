<div class="min-h-[70vh] flex items-center justify-center py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-6 bg-[#15161c] p-7 sm:p-9 rounded-2xl border border-[#262833] shadow-md">
    <div class="text-center">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-[#221e30] border border-[#a78bfa]/25 text-[#a78bfa] mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h2 class="text-2xl font-black text-[#f1f3f7] tracking-tight">Yeni Şifre Belirle</h2>
      <p class="mt-1.5 text-xs text-[#8b90a0]">Hesabınız için güvenli bir yeni şifre girin.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "mt-6 space-y-4", data: { controller: "bridge--form" } }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div>
        <%= f.label :password, "Yeni Şifre", class: "block text-xs font-semibold uppercase tracking-wider text-[#8b90a0] mb-1.5" %>
        <% if @minimum_password_length %>
          <p class="text-[11px] text-[#686d80] mb-1.5">En az <%= @minimum_password_length %> karakter</p>
        <% end %>
        <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "••••••••", class: "w-full px-3.5 py-2.5 bg-[#1c1d25] border border-[#262833] rounded-xl text-[#f1f3f7] placeholder-[#686d80] focus:outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed] text-xs sm:text-sm transition" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Yeni Şifre Tekrar", class: "block text-xs font-semibold uppercase tracking-wider text-[#8b90a0] mb-1.5" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "w-full px-3.5 py-2.5 bg-[#1c1d25] border border-[#262833] rounded-xl text-[#f1f3f7] placeholder-[#686d80] focus:outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed] text-xs sm:text-sm transition" %>
      </div>

      <div>
        <%= f.submit "Şifreyi Güncelle", data: { "bridge--form-target": "submit", bridge_title: "Şifreyi Güncelle" }, class: "w-full py-2.5 px-4 bg-[#6d28d9] hover:bg-[#5b21b6] text-white font-semibold rounded-xl text-xs sm:text-sm shadow-sm transition duration-150 cursor-pointer" %>
      </div>
    <% end %>

    <div class="text-center pt-1">
      <p class="text-xs text-[#8b90a0]">
        <%= link_to "Giriş ekranına dön", new_session_path(resource_name), class: "font-semibold text-[#a78bfa] hover:underline" %>
      </p>
    </div>
  </div>
</div>
