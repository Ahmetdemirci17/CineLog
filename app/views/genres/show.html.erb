<div class="space-y-6 sm:space-y-8">
  <div class="border-b border-[#1f202a] pb-4 sm:pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4">
    <div>
      <%= link_to "← Tüm Katalog", genres_path, class: "text-xs font-semibold text-[#a78bfa] hover:text-white transition inline-flex items-center gap-1 mb-2" %>
      <h1 class="text-2xl sm:text-3xl font-black text-[#f1f3f7] tracking-tight flex items-center gap-2 sm:gap-2.5">
        <span class="w-2.5 h-6 rounded bg-[#7c3aed]"></span>
        <span><%= @genre_name %> — En Beğenilenler</span>
      </h1>
      <p class="text-xs sm:text-sm text-[#8b90a0] mt-1"><%= @genre_name %> türündeki en yüksek puanlı başyapıtlar.</p>
    </div>

    <span class="text-xs font-semibold text-[#8b90a0] px-3 py-1.5 rounded-xl bg-[#15161c] border border-[#262833] self-start sm:self-auto">
      <%= @movies.size %> Başyapıt Listelendi
    </span>
  </div>

  <% if @movies.empty? %>
    <div class="text-center py-20 bg-[#15161c] rounded-2xl border border-[#262833]">
      <p class="text-sm font-bold text-[#f1f3f7]">Bu türde henüz yapım bulunamadı.</p>
      <%= link_to "Tüm Kataloğa Dön", genres_path, class: "mt-4 inline-block px-4 py-2 text-xs font-semibold rounded-xl bg-[#6d28d9] text-white" %>
    </div>
  <% else %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-6">
      <% @movies.each do |movie| %>
        <%= render "movies/card", item: movie, watchlist_map: @user_watchlist_map %>
      <% end %>
    </div>
  <% end %>
</div>
