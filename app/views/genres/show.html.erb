<div class="space-y-6 sm:space-y-8">
  <!-- Header & Filter Bar -->
  <div class="border-b border-zinc-800/80 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <%= link_to genres_path, class: "text-xs font-semibold text-purple-400 hover:text-white transition inline-flex items-center gap-1.5 mb-2.5 group" do %>
        <span class="group-hover:-translate-x-0.5 transition duration-150">←</span>
        <span>Tüm Kataloğa Dön</span>
      <% end %>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight flex items-center gap-3">
        <span class="w-2.5 h-7 rounded-full bg-purple-500"></span>
        <span><%= @genre_name %> Filmleri</span>
      </h1>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">
        <% if @total_results > 0 %>
          <span>Toplam <strong class="text-white font-semibold"><%= number_with_delimiter(@total_results, delimiter: ".") %></strong> film • Sayfa <strong class="text-purple-400 font-semibold"><%= @page %></strong> / <%= @total_pages %></span>
        <% else %>
          <span><%= @genre_name %> türündeki tüm filmler listeleniyor.</span>
        <% end %>
      </p>
    </div>

    <!-- Sorting Filter Pills -->
    <div class="flex items-center gap-1.5 p-1 rounded-2xl bg-[#121217] border border-zinc-800/80 self-start md:self-auto overflow-x-auto max-w-full">
      <%= link_to genre_path(@genre_id, sort_by: "popularity.desc", page: 1), class: "px-3.5 py-1.5 rounded-xl text-xs font-semibold transition whitespace-nowrap #{@sort_by == 'popularity.desc' ? 'bg-purple-600 text-white shadow-md shadow-purple-600/25' : 'text-zinc-400 hover:text-white hover:bg-zinc-800/60'}" do %>
        🔥 En Popüler
      <% end %>

      <%= link_to genre_path(@genre_id, sort_by: "vote_average.desc", page: 1), class: "px-3.5 py-1.5 rounded-xl text-xs font-semibold transition whitespace-nowrap #{@sort_by == 'vote_average.desc' ? 'bg-purple-600 text-white shadow-md shadow-purple-600/25' : 'text-zinc-400 hover:text-white hover:bg-zinc-800/60'}" do %>
        ⭐ En Beğenilenler
      <% end %>

      <%= link_to genre_path(@genre_id, sort_by: "primary_release_date.desc", page: 1), class: "px-3.5 py-1.5 rounded-xl text-xs font-semibold transition whitespace-nowrap #{@sort_by == 'primary_release_date.desc' ? 'bg-purple-600 text-white shadow-md shadow-purple-600/25' : 'text-zinc-400 hover:text-white hover:bg-zinc-800/60'}" do %>
        📅 En Yeni
      <% end %>
    </div>
  </div>

  <!-- Movies Grid -->
  <% if @movies.empty? %>
    <div class="text-center py-20 bg-[#121217] rounded-3xl border border-zinc-800/80 p-8 shadow-xl">
      <div class="w-16 h-16 rounded-2xl bg-purple-600/10 border border-purple-500/20 text-purple-400 flex items-center justify-center mx-auto mb-4 text-2xl">
        🎬
      </div>
      <h3 class="text-lg font-bold text-white">Bu sayfada yapım bulunamadı</h3>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-sm mx-auto mt-2">
        Geçerli bir sayfa numarası seçebilir veya sıralama kriterini değiştirebilirsiniz.
      </p>
      <div class="mt-6">
        <%= link_to "İlk Sayfaya Dön", genre_path(@genre_id, sort_by: @sort_by, page: 1), class: "px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold shadow-lg shadow-purple-600/25 transition inline-block" %>
      </div>
    </div>
  <% else %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-6">
      <% @movies.each do |movie| %>
        <%= render "movies/card", item: movie, watchlist_map: @user_watchlist_map %>
      <% end %>
    </div>

    <!-- Pagination Controls -->
    <% if @total_pages > 1 %>
      <%
        start_page = [@page - 2, 1].max
        end_page = [@page + 2, @total_pages].min
      %>
      <div class="pt-10 pb-6 flex flex-col sm:flex-row items-center justify-center gap-4 border-t border-zinc-800/80">
        <nav class="inline-flex items-center gap-1.5 flex-wrap justify-center" aria-label="Sayfalama">
          <!-- Previous Page Button -->
          <% if @page > 1 %>
            <%= link_to genre_path(@genre_id, page: @page - 1, sort_by: @sort_by), class: "px-3.5 py-2 rounded-xl bg-[#121217] hover:bg-zinc-800 border border-zinc-800 hover:border-purple-500/40 text-xs font-semibold text-zinc-300 hover:text-white transition flex items-center gap-1" do %>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>
              <span>Önceki</span>
            <% end %>
          <% else %>
            <span class="px-3.5 py-2 rounded-xl bg-[#121217] border border-zinc-800/40 text-xs font-semibold text-zinc-600 opacity-40 cursor-not-allowed flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>
              <span>Önceki</span>
            </span>
          <% end %>

          <!-- First Page + Ellipsis if needed -->
          <% if start_page > 1 %>
            <%= link_to "1", genre_path(@genre_id, page: 1, sort_by: @sort_by), class: "w-9 h-9 flex items-center justify-center rounded-xl bg-[#121217] hover:bg-zinc-800 border border-zinc-800 text-xs font-semibold text-zinc-300 hover:text-white transition" %>
            <% if start_page > 2 %>
              <span class="w-7 text-center text-xs text-zinc-600">...</span>
            <% end %>
          <% end %>

          <!-- Page Numbers Around Current Page -->
          <% (start_page..end_page).each do |p| %>
            <% if p == @page %>
              <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-purple-600 border border-purple-500 text-xs font-black text-white shadow-lg shadow-purple-600/30">
                <%= p %>
              </span>
            <% else %>
              <%= link_to p.to_s, genre_path(@genre_id, page: p, sort_by: @sort_by), class: "w-9 h-9 flex items-center justify-center rounded-xl bg-[#121217] hover:bg-zinc-800 border border-zinc-800 hover:border-purple-500/40 text-xs font-semibold text-zinc-300 hover:text-white transition" %>
            <% end %>
          <% end %>

          <!-- Last Page + Ellipsis if needed -->
          <% if end_page < @total_pages %>
            <% if end_page < @total_pages - 1 %>
              <span class="w-7 text-center text-xs text-zinc-600">...</span>
            <% end %>
            <%= link_to @total_pages.to_s, genre_path(@genre_id, page: @total_pages, sort_by: @sort_by), class: "w-9 h-9 flex items-center justify-center rounded-xl bg-[#121217] hover:bg-zinc-800 border border-zinc-800 text-xs font-semibold text-zinc-300 hover:text-white transition" %>
          <% end %>

          <!-- Next Page Button -->
          <% if @page < @total_pages %>
            <%= link_to genre_path(@genre_id, page: @page + 1, sort_by: @sort_by), class: "px-3.5 py-2 rounded-xl bg-[#121217] hover:bg-zinc-800 border border-zinc-800 hover:border-purple-500/40 text-xs font-semibold text-zinc-300 hover:text-white transition flex items-center gap-1" do %>
              <span>Sonraki</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
            <% end %>
          <% else %>
            <span class="px-3.5 py-2 rounded-xl bg-[#121217] border border-zinc-800/40 text-xs font-semibold text-zinc-600 opacity-40 cursor-not-allowed flex items-center gap-1">
              <span>Sonraki</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
            </span>
          <% end %>
        </nav>

        <!-- Quick Jump to Page Form -->
        <form action="<%= genre_path(@genre_id) %>" method="get" class="flex items-center gap-1.5 text-xs text-zinc-400">
          <input type="hidden" name="sort_by" value="<%= @sort_by %>">
          <span>Sayfaya Git:</span>
          <input type="number" name="page" min="1" max="<%= @total_pages %>" placeholder="<%= @page %>" class="w-14 px-2 py-1.5 text-xs rounded-xl bg-[#121217] border border-zinc-800 text-center text-white focus:outline-none focus:border-purple-500 transition">
          <button type="submit" class="px-2.5 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white font-semibold transition cursor-pointer">Git</button>
        </form>
      </div>
    <% end %>
  <% end %>
</div>
