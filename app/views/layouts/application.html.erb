<!DOCTYPE html>
<html lang="tr" class="h-full bg-[#0d0e12] text-[#f1f3f7] antialiased">
  <head>
    <title><%= content_for(:title) || "CineLog — Film & Dizi Takip ve Topluluk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="CineLog">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
    </style>
  </head>

  <body class="min-h-full flex flex-col bg-[#0a0a0c] text-[#f1f3f7] selection:bg-[#9333ea] selection:text-white relative">
    <div class="ambient-glow"></div>
    <%= render "shared/navbar" %>

    <!-- Flash Notifications Container -->
    <div id="flash-messages" class="fixed top-20 right-4 z-50 flex flex-col gap-2 max-w-md w-full pointer-events-none px-4">
      <% if notice.present? %>
        <div class="pointer-events-auto flex items-center justify-between p-4 rounded-xl bg-[#15161c] border border-[#262833] text-white shadow-lg">
          <div class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-[#6d28d9]/25 text-[#a78bfa] flex items-center justify-center font-bold text-xs">✓</span>
            <p class="text-xs sm:text-sm font-medium text-[#f1f3f7]"><%= notice %></p>
          </div>
          <button onclick="this.parentElement.remove()" class="text-[#8b90a0] hover:text-white text-xs ml-3 p-1 cursor-pointer">✕</button>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="pointer-events-auto flex items-center justify-between p-4 rounded-xl bg-[#15161c] border border-red-500/30 text-white shadow-lg">
          <div class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-full bg-red-500/20 text-red-400 flex items-center justify-center font-bold text-xs">!</span>
            <p class="text-xs sm:text-sm font-medium text-[#f1f3f7]"><%= alert %></p>
          </div>
          <button onclick="this.parentElement.remove()" class="text-[#8b90a0] hover:text-white text-xs ml-3 p-1 cursor-pointer">✕</button>
        </div>
      <% end %>
    </div>

    <!-- Main Content -->
    <main class="flex-1 w-full max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12 py-6 sm:py-10 pb-24 md:pb-10">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-800/80 bg-[#0a0a0c] py-8 sm:py-10 mt-16 text-xs text-zinc-400 mb-16 md:mb-0">
      <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-xl bg-gradient-to-br from-purple-600/30 to-purple-900/50 border border-purple-500/30 flex items-center justify-center text-purple-400 text-xs font-black">C</div>
          <span class="font-bold text-white tracking-tight">Cine<span class="text-purple-400">Log</span></span>
          <span class="text-zinc-600">| Modern Film & Dizi Günlüğü</span>
        </div>
        <p class="text-zinc-500">&copy; <%= Date.current.year %> CineLog. Tüm hakları saklıdır.</p>
      </div>
    </footer>
  </body>
</html>
