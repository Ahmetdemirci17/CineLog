<div class="max-w-4xl mx-auto space-y-8">
  <div>
    <%= link_to "← Topluluk & Önerilere Dön", community_posts_path, class: "text-xs font-semibold text-[#a78bfa] hover:text-[#f1f3f7] transition inline-flex items-center gap-1.5 mb-2" %>
  </div>

  <div class="p-6 sm:p-8 rounded-3xl bg-[#15161c] border border-[#262833] shadow-md space-y-6">
    <div class="flex items-start justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-[#272236] border border-[#a78bfa]/25 flex items-center justify-center text-xs font-bold text-[#a78bfa]">
          <%= @community_post.user.username[0].upcase %>
        </div>
        <div>
          <h3 class="text-sm font-bold text-[#f1f3f7]"><%= @community_post.user.username %></h3>
          <p class="text-xs text-[#686d80]"><%= time_ago_in_words(@community_post.created_at) %> önce paylaşıldı</p>
        </div>
      </div>

      <% if user_signed_in? && @community_post.user == current_user %>
        <%= button_to community_post_path(@community_post), method: :delete, data: { turbo_confirm: "Bu konuyu silmek istediğinize emin misiniz?" }, class: "text-xs text-[#8b90a0] hover:text-red-400 transition flex items-center gap-1 px-3 py-1.5 rounded-lg bg-[#1c1d25] border border-[#262833] cursor-pointer" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          <span>Sil</span>
        <% end %>
      <% end %>
    </div>

    <div class="space-y-3">
      <h1 class="text-2xl sm:text-3xl font-black text-[#f1f3f7] tracking-tight leading-snug">
        <%= @community_post.title %>
      </h1>
      <div class="text-sm text-[#cbd5e1] leading-relaxed whitespace-pre-wrap">
        <%= simple_format(@community_post.content) %>
      </div>
    </div>

    <% if @attached_media.present? %>
      <%
        media_title = @attached_media["title"] || @attached_media["name"]
        media_poster = @attached_media["poster_path"]
        media_url = @community_post.media_type == "tv" ? tv_show_path(@community_post.tmdb_id) : movie_path(@community_post.tmdb_id)
        media_rating = @attached_media["vote_average"] ? @attached_media["vote_average"].round(1) : nil
      %>
      <div class="p-3.5 rounded-2xl bg-[#1c1d25] border border-[#262833] flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
          <% if media_poster.present? %>
            <img src="<%= TmdbService.poster_url(media_poster, size: "w92") %>" alt="<%= media_title %>" class="w-10 h-14 rounded-lg object-cover shrink-0">
          <% end %>
          <div class="min-w-0">
            <span class="text-[10px] uppercase font-bold text-[#a78bfa] tracking-wider">İlişkili <%= @community_post.media_type == 'tv' ? 'Dizi' : 'Film' %></span>
            <h4 class="text-sm font-bold text-[#f1f3f7] truncate"><%= media_title %></h4>
            <% if media_rating.present? %>
              <p class="text-xs text-amber-400 font-semibold">★ <%= media_rating %> / 10</p>
            <% end %>
          </div>
        </div>

        <%= link_to "İncele →", media_url, class: "px-3 py-1.5 text-xs font-semibold rounded-lg bg-[#272236] text-[#a78bfa] border border-[#a78bfa]/25 hover:bg-[#6d28d9] hover:text-white transition shrink-0" %>
      </div>
    <% end %>
  </div>

  <div class="space-y-6 pt-4">
    <div class="flex items-center justify-between border-b border-[#1f202a] pb-3">
      <h2 class="text-base font-bold text-[#f1f3f7] flex items-center gap-2">
        <span class="w-1.5 h-3.5 rounded bg-[#7c3aed]"></span>
        <span>Yanıtlar</span>
        <span id="replies_count" class="text-xs text-[#8b90a0] font-normal">
          (<%= @replies.count %> Yanıt)
        </span>
      </h2>
    </div>

    <div class="bg-[#15161c] p-4 rounded-2xl border border-[#262833]">
      <%= render partial: "community_replies/form", locals: { community_post: @community_post, reply: @reply } %>
    </div>

    <div id="replies_list" class="space-y-3">
      <% if @replies.empty? %>
        <div id="no_replies_banner" class="p-8 rounded-2xl bg-[#15161c] border border-[#262833] text-center">
          <p class="text-xs text-[#8b90a0]">Henüz yanıt yazılmamış. İlk yanıtı siz yazın!</p>
        </div>
      <% else %>
        <% @replies.each do |reply| %>
          <%= render "community_replies/reply", reply: reply %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
