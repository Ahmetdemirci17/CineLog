<div class="space-y-8">
  <!-- Forum Header Banner -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-zinc-800/80 pb-6">
    <div>
      <h1 class="text-3xl lg:text-4xl font-black text-white tracking-tight">
        Topluluk & <span class="text-purple-400">Tartışmalar</span>
      </h1>
      <p class="text-xs sm:text-sm text-zinc-400 mt-1">Film ve dizi tavsiyeleri isteyin, teorilerinizi ve incelemelerinizi sinemaseverlerle paylaşın.</p>
    </div>

    <%= link_to new_community_post_path, class: "px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs sm:text-sm font-semibold shadow-lg shadow-purple-600/25 transition duration-200 inline-flex items-center gap-2 self-start sm:self-auto" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <span>Yeni Konu Aç</span>
    <% end %>
  </div>

  <!-- 2-Column Responsive Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Main Feed (8 Cols) -->
    <div class="lg:col-span-8 space-y-4">
      <% if @posts.empty? %>
        <div class="text-center py-20 bg-[#121217] rounded-3xl border border-zinc-800/80 p-8 shadow-xl">
          <div class="w-16 h-16 rounded-2xl bg-purple-600/10 border border-purple-500/20 text-purple-400 flex items-center justify-center mx-auto mb-4 text-2xl">
            💬
          </div>
          <h3 class="text-lg font-bold text-white">Henüz bir konu açılmamış</h3>
          <p class="text-xs sm:text-sm text-zinc-400 max-w-sm mx-auto mt-2 leading-relaxed">
            İlk öneri isteğini, film eleştirisini veya sorunu paylaşarak topluluğu sen başlat!
          </p>
          <div class="mt-6">
            <%= link_to "İlk Konuyu Aç", new_community_post_path, class: "px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold shadow-lg shadow-purple-600/25 transition" %>
          </div>
        </div>
      <% else %>
        <% @posts.each do |post| %>
          <article class="p-5 sm:p-6 rounded-2xl bg-[#121217] border border-zinc-800/80 hover:border-purple-500/40 hover:shadow-[0_4px_25px_rgba(147,51,234,0.1)] transition duration-200 flex flex-col gap-4 group">
            
            <!-- Author Header & Media Badge -->
            <div class="flex items-center justify-between gap-3 flex-wrap">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-purple-900/60 to-purple-600/30 border border-purple-500/30 flex items-center justify-center text-xs font-black text-purple-300 shadow-sm">
                  <%= post.user.username[0].upcase %>
                </div>
                <div>
                  <span class="text-xs font-bold text-zinc-200 group-hover:text-white transition"><%= post.user.username %></span>
                  <span class="text-[11px] text-zinc-500 ml-2">• <%= time_ago_in_words(post.created_at) %> önce</span>
                </div>
              </div>

              <% if post.tmdb_id.present? %>
                <% media_url = post.media_type == 'tv' ? tv_show_path(post.tmdb_id) : movie_path(post.tmdb_id) %>
                <%= link_to media_url, class: "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-purple-500/10 hover:bg-purple-500/20 text-purple-300 border border-purple-500/20 text-xs font-medium transition duration-150" do %>
                  <span><%= post.media_type == 'tv' ? '📺 Dizi Tartışması' : '🎬 Film Tartışması' %></span>
                  <svg class="w-3 h-3 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                <% end %>
              <% end %>
            </div>

            <!-- Post Content -->
            <div>
              <h2 class="text-base sm:text-lg font-bold text-white group-hover:text-purple-300 transition line-clamp-1">
                <%= link_to post.title, community_post_path(post) %>
              </h2>
              <p class="text-xs sm:text-sm text-zinc-400 mt-1.5 line-clamp-2 leading-relaxed">
                <%= post.content %>
              </p>
            </div>

            <!-- Post Footer & Action -->
            <div class="pt-3 border-t border-zinc-800/80 flex items-center justify-between text-xs">
              <div class="flex items-center gap-2 text-zinc-400 font-medium">
                <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-zinc-900/80 border border-zinc-800">
                  <svg class="w-3.5 h-3.5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                  <span class="font-bold text-white"><%= post.community_replies.count %></span>
                  <span class="text-zinc-500">yanıt</span>
                </span>
              </div>

              <%= link_to community_post_path(post), class: "font-semibold text-purple-400 hover:text-purple-300 flex items-center gap-1 transition text-xs group-hover:translate-x-0.5" do %>
                <span>Tartışmaya Katıl</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              <% end %>
            </div>

          </article>
        <% end %>
      <% end %>
    </div>

    <!-- Sidebar (4 Cols) -->
    <aside class="lg:col-span-4 space-y-6">
      
      <!-- Community Stats Card -->
      <div class="p-5 rounded-2xl bg-[#121217] border border-zinc-800/80 shadow-md">
        <h3 class="text-sm font-bold text-white flex items-center gap-2 mb-4">
          <span class="text-purple-400">📊</span>
          <span>Topluluk Durumu</span>
        </h3>
        <div class="grid grid-cols-2 gap-3">
          <div class="p-3 rounded-xl bg-zinc-900/60 border border-zinc-800/80">
            <span class="text-[11px] text-zinc-500 block">Toplam Konu</span>
            <span class="text-lg font-black text-white mt-0.5 block"><%= @posts.count %></span>
          </div>
          <div class="p-3 rounded-xl bg-zinc-900/60 border border-zinc-800/80">
            <span class="text-[11px] text-zinc-500 block">Toplam Yanıt</span>
            <span class="text-lg font-black text-purple-400 mt-0.5 block"><%= @posts.sum { |p| p.community_replies.size } %></span>
          </div>
        </div>
      </div>

      <!-- Guidelines Card -->
      <div class="p-5 rounded-2xl bg-[#121217] border border-zinc-800/80 shadow-md">
        <h3 class="text-sm font-bold text-white flex items-center gap-2 mb-3">
          <span class="text-purple-400">📜</span>
          <span>Topluluk Kuralları</span>
        </h3>
        <ul class="space-y-2.5 text-xs text-zinc-400">
          <li class="flex items-start gap-2">
            <span class="text-purple-400 font-bold">•</span>
            <span>Diğer üyelere ve farklı film zevklerine karşı saygılı olun.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-purple-400 font-bold">•</span>
            <span>Sürprizbozan (Spoiler) içeren paylaşımlarda başlıkta belirtin.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-purple-400 font-bold">•</span>
            <span>Konu açarken ilgili filmi veya diziyi bağlayarak tartışmayı zenginleştirin.</span>
          </li>
        </ul>
      </div>

      <!-- Quick Action Card -->
      <div class="p-5 rounded-2xl bg-gradient-to-br from-purple-950/40 via-[#121217] to-[#121217] border border-purple-500/20 shadow-lg">
        <h3 class="text-sm font-bold text-white">Film Önerisi mi Arıyorsun?</h3>
        <p class="text-xs text-zinc-400 mt-1.5 leading-relaxed">
          Aradığın tarzı, sevdiğin filmleri belirterek topluluktan anında öneri alabilirsin.
        </p>
        <div class="mt-4">
          <%= link_to "Tavsiye İste", new_community_post_path, class: "w-full text-center block py-2.5 px-4 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold shadow-md shadow-purple-600/20 transition" %>
        </div>
      </div>

    </aside>

  </div>
</div>
